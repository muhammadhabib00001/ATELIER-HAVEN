---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbItems = [
  { name: 'Terms of Service' }
];

const lastUpdated = "September 1, 2026";
---

<BaseLayout
  title="Terms of Service & Agreement | Atrium Livings"
  description="Terms and conditions governing the access and use of Atrium Livings's digital home decor and DIY magazine."
  breadcrumbs={breadcrumbItems}
  noindex={true}
>
  <Breadcrumbs items={breadcrumbItems} />

  <div class="legal-page-container">
    <div class="container legal-content-wrapper">
      <header class="legal-header">
        <span class="legal-kicker">Legal Governance</span>
        <h1 class="legal-title">Terms of Service</h1>
        <p class="legal-meta">Effective Date: {lastUpdated} &bull; Atrium Livings Media Group, Inc.</p>
      </header>

      <div class="legal-prose">
        <p class="lead">By accessing and reading Atrium Livings (accessible at atriumlivings.com), you agree to be bound by these Terms of Service, all applicable laws, and regulations. If you disagree with any part of these terms, you must refrain from using the publication.</p>

        <h2>1. Intellectual Property & Copyright Protection</h2>
        <p>All editorial prose, DIY guides, custom decor illustrations, and photography featured on Atrium Livings are the protected intellectual property of Atrium Livings Media Group, Inc. and its contributing licensors under United States and international copyright laws.</p>
        <p>You may quote brief editorial excerpts (up to 75 words) provided direct attribution and a canonical hyperlink to the original article URL are visibly preserved. Wholesale republication or scraping without written consent is strictly prohibited.</p>

        <h2>2. Home Improvement & DIY Advisory Disclaimer</h2>
        <p>All articles, room styling ideas, DIY tutorials, and decor guides published on Atrium Livings are provided solely for creative inspiration and informational purposes. They do not constitute licensed engineering, architecture-of-record, or professional contracting advice.</p>
        <p>Always consult qualified, licensed local professionals (such as electricians, plumbers, or structural contractors) when undertaking major home renovations, structural modifications, or complex electrical work.</p>

        <h2>3. External Links & Affiliations</h2>
        <p>Our articles may contain links to third-party home decor brands, DIY suppliers, craft resources, and design websites. We do not endorse and assume no legal liability for the content, privacy practices, or availability of third-party domains.</p>

        <h2>4. Governing Law & Jurisdiction</h2>
        <p>These terms are governed by and construed in accordance with the laws of the State of California, without regard to its conflict of law provisions. Any legal disputes arising hereunder shall be subject to the exclusive jurisdiction of the state and federal courts located in San Francisco County, California.</p>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .legal-page-container {
    padding: 4rem 0 6rem;
  }
  .legal-content-wrapper {
    max-width: 800px;
    margin: 0 auto;
  }
  .legal-header {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 2rem;
    margin-bottom: 2.5rem;
  }
  .legal-kicker {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-accent);
    display: block;
    margin-bottom: 0.5rem;
  }
  .legal-title {
    font-family: var(--font-serif);
    font-size: 2.75rem;
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 0.75rem;
  }
  .legal-meta {
    font-size: 0.8125rem;
    color: var(--color-text-light);
  }
  .legal-prose {
    font-size: 1.05rem;
    line-height: 1.75;
    color: #2D2A26;
  }
  .legal-prose .lead {
    font-size: 1.15rem;
    color: var(--color-text-main);
    margin-bottom: 2rem;
  }
  .legal-prose h2 {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 700;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    color: var(--color-text-main);
  }
  .legal-prose p {
    margin-bottom: 1.25rem;
  }
</style>