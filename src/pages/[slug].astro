---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SocialShare from '../components/SocialShare.astro';
import Newsletter from '../components/Newsletter.astro';
import ArticleCard from '../components/ArticleCard.astro';
import siteData from '../data/site.json';
import articles from '../data/articles.json';

export function getStaticPaths() {
  return articles.map(article => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

const { article } = Astro.props;

const author = siteData.authors.find(a => a.slug === article.author) || siteData.authors[0];
const category = siteData.categories.find(c => c.slug === article.category) || { name: article.category, slug: article.category };

// Sidebar Articles: Same category preferred, then recent
const categoryArticles = articles.filter(a => a.slug !== article.slug && a.category === article.category);
const otherArticles = articles.filter(a => a.slug !== article.slug && a.category !== article.category);
const sidebarArticles = [...categoryArticles, ...otherArticles].slice(0, 4);

// Bottom Related Articles: 3 cards
const relatedArticles = [...categoryArticles, ...otherArticles].slice(0, 3);

// Latest Articles: 4 cards
const latestArticles = articles
  .filter(a => a.slug !== article.slug)
  .sort((a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime())
  .slice(0, 4);

const breadcrumbItems = [
  { name: 'Home', url: '/' },
  { name: category.name, url: `/category/${category.slug}/` },
  { name: article.title }
];

const formattedPublishedDate = new Date(article.publishedAt).toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric'
});

const formattedUpdatedDate = article.updatedAt ? new Date(article.updatedAt).toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric'
}) : null;

const pageTitle = article.seoTitle
  ? `${article.seoTitle} | Atrium Livings`
  : `${article.title} | Atrium Livings`;
---

<BaseLayout
  title={pageTitle}
  description={article.seoDescription || article.subtitle}
  image={article.coverImage}
  type="article"
  publishedTime={article.publishedAt}
  modifiedTime={article.updatedAt || article.publishedAt}
  authorName={author.name}
  keywords={article.keywords}
  breadcrumbs={breadcrumbItems}
  jsonLdType="article"
  jsonLdData={{ article, author }}
>
  <Breadcrumbs items={breadcrumbItems} />

  <article class="article-page">
    <!-- Top Header Area -->
    <header class="article-header">
      <div class="container">
        <div class="header-inner">
          <div class="article-kicker-row">
            <a href={`/category/${category.slug}/`} class="article-category-badge">
              {category.name}
            </a>
            <span class="kicker-sep">&bull;</span>
            <span class="read-duration">{article.readTime}</span>
          </div>

          <h1 class="article-headline">{article.title}</h1>
          <p class="article-subheadline">{article.subtitle}</p>

          <!-- Byline & Social Bar -->
          <div class="article-byline-bar">
            <div class="author-block">
              <img
                src={author.avatar}
                alt={author.name}
                width="44"
                height="44"
                class="author-portrait"
                crossorigin="anonymous"
                referrerpolicy="no-referrer-when-downgrade"
              />
              <div class="author-meta">
                <span class="byline-name">
                  By <a href={`/author/${author.slug}/`}>{author.name}</a>
                </span>
                <span class="byline-date">
                  Updated {formattedUpdatedDate || formattedPublishedDate}
                </span>
              </div>
            </div>

            <div class="header-social-share">
              <SocialShare url={Astro.url.href} title={article.title} description={article.subtitle} />
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content & Sidebar Grid (Spruce 2-Column Layout) -->
    <div class="container article-layout-grid">
      <!-- Main Content Column -->
      <div class="article-main-col">
        <!-- Hero Cover Image -->
        <div class="article-cover-wrap">
          <img
            src={article.coverImage}
            alt={article.coverAlt || article.title}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            width="1200"
            height="700"
            class="cover-image"
            crossorigin="anonymous"
            referrerpolicy="no-referrer-when-downgrade"
          />
          {article.coverAlt && (
            <figcaption class="cover-caption">{article.coverAlt}</figcaption>
          )}
        </div>



        <!-- Mobile In-Line Table of Contents -->
        {article.toc && article.toc.length > 0 && (
          <div class="mobile-toc-card">
            <div class="mobile-toc-header">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="8" y1="6" x2="21" y2="6"></line>
                <line x1="8" y1="12" x2="21" y2="12"></line>
                <line x1="8" y1="18" x2="21" y2="18"></line>
                <line x1="3" y1="6" x2="3.01" y2="6"></line>
                <line x1="3" y1="12" x2="3.01" y2="12"></line>
                <line x1="3" y1="18" x2="3.01" y2="18"></line>
              </svg>
              <span>In This Article</span>
            </div>
            <ul class="mobile-toc-list">
              {article.toc.map((item: { id: string; title: string }) => (
                <li>
                  <a href={`#${item.id}`}>{item.title}</a>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Article Prose HTML Content -->
        <div class="prose-content" set:html={article.content} />

        <!-- Editorial Trust & Integrity Box -->
        <div class="fact-check-box">
          <div class="fact-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <div class="fact-text">
            <h4>Editorial Quality & Review Process</h4>
            <p>
              Atrium Livings articles are authored and reviewed by certified architects, structural designers, and interior planning specialists. We test dimensions and specifications against national residential codes. Read our <a href="/editorial-policy/">Editorial Policy</a>.
            </p>
          </div>
        </div>

        <!-- Bottom Social Share -->
        <div class="bottom-share-row">
          <span class="bottom-share-label">Share this guide:</span>
          <SocialShare url={Astro.url.href} title={article.title} description={article.subtitle} />
        </div>

        <!-- Author Bio Card -->
        <section class="author-bio-card" aria-labelledby="author-bio-title">
          <img
            src={author.avatar}
            alt={author.name}
            width="72"
            height="72"
            class="author-bio-avatar"
            crossorigin="anonymous"
            referrerpolicy="no-referrer-when-downgrade"
          />
          <div class="author-bio-details">
            <span class="bio-eyebrow">About the Author</span>
            <h3 id="author-bio-title" class="author-bio-name">
              <a href={`/author/${author.slug}/`}>{author.name}</a>
            </h3>
            <span class="author-bio-role">{author.role}</span>
            <p class="author-bio-text">{author.bio}</p>
            <a href={`/author/${author.slug}/`} class="author-folio-link">View all articles by {author.name} &rarr;</a>
          </div>
        </section>
      </div>

      <!-- Right Rail Sidebar (The Spruce Magazine Layout) -->
      <aside class="article-sidebar">
        <!-- Sticky Widget: Table of Contents -->
        {article.toc && article.toc.length > 0 && (
          <div class="sidebar-widget toc-widget">
            <div class="widget-header">
              <span class="widget-title">In This Article</span>
            </div>
            <nav class="sidebar-toc-nav" aria-label="Table of contents">
              <ol class="sidebar-toc-list">
                {article.toc.map((item: { id: string; title: string }, idx: number) => (
                  <li>
                    <a href={`#${item.id}`} class="sidebar-toc-link">
                      <span class="toc-step">{idx + 1}.</span>
                      <span class="toc-name">{item.title}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          </div>
        )}

        <!-- More in Category Widget -->
        <div class="sidebar-widget">
          <div class="widget-header">
            <span class="widget-title">More in {category.name}</span>
          </div>
          <div class="sidebar-articles-list">
            {sidebarArticles.map(art => (
              <a href={`/${art.slug}/`} class="sidebar-card-link">
                <div class="sidebar-card-img-wrap">
                  <img
                    src={art.coverImage}
                    alt={art.title}
                    width="90"
                    height="60"
                    loading="lazy"
                    class="sidebar-card-img"
                    crossorigin="anonymous"
                    referrerpolicy="no-referrer-when-downgrade"
                  />
                </div>
                <div class="sidebar-card-text">
                  <h4 class="sidebar-card-title">{art.title}</h4>
                  <span class="sidebar-card-time">{art.readTime}</span>
                </div>
              </a>
            ))}
          </div>
        </div>

        <!-- Mini Newsletter Widget -->
        <div class="sidebar-widget nl-widget">
          <span class="nl-eyebrow">Newsletter</span>
          <h4 class="nl-widget-title">Get Expert Design Tips</h4>
          <p class="nl-widget-desc">Weekly architectural guidance delivered straight to your inbox.</p>
          <form class="sidebar-nl-form" onsubmit="event.preventDefault(); alert('Thank you for subscribing!');">
            <input type="email" placeholder="Your email address" required aria-label="Email address" class="sidebar-nl-input" />
            <button type="submit" class="sidebar-nl-btn">Sign Up</button>
          </form>
        </div>
      </aside>
    </div>
  </article>

  <!-- Related Articles Grid (Below Article) -->
  {relatedArticles.length > 0 && (
    <section class="bottom-related-section">
      <div class="container">
        <div class="section-bar">
          <span class="section-bar-label">Related Guides</span>
          <div class="section-bar-line"></div>
        </div>
        <div class="bottom-cards-grid three-col">
          {relatedArticles.map(art => (
            <ArticleCard article={art} variant="standard" />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Latest Guides Section -->
  {latestArticles.length > 0 && (
    <section class="bottom-latest-section">
      <div class="container">
        <div class="section-bar">
          <span class="section-bar-label">Latest from Atrium Livings</span>
          <div class="section-bar-line"></div>
        </div>
        <div class="bottom-cards-grid four-col">
          {latestArticles.map(art => (
            <ArticleCard article={art} variant="standard" />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Full Width Newsletter -->
  <Newsletter />
</BaseLayout>

<style>
  /* ===== Header Area ===== */
  .article-header {
    padding: 2rem 0 1.5rem;
    background: #ffffff;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 2rem;
  }

  .header-inner {
    max-width: 900px;
  }

  .article-kicker-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.85rem;
  }

  .article-category-badge {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    text-decoration: none;
  }

  .article-category-badge:hover {
    text-decoration: underline;
  }

  .kicker-sep {
    color: var(--color-border-dark);
    font-size: 0.75rem;
  }

  .read-duration {
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--color-text-light);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .article-headline {
    font-family: var(--font-serif);
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-text-main);
    margin-bottom: 0.85rem;
    letter-spacing: -0.01em;
  }

  .article-subheadline {
    font-family: var(--font-sans);
    font-size: 1.1rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    font-weight: 400;
  }

  .article-byline-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--color-border);
    padding-top: 1rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .author-block {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .author-portrait {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
  }

  .author-meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .byline-name {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-main);
  }

  .byline-name a {
    color: inherit;
    text-decoration: none;
  }

  .byline-name a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .byline-date {
    font-size: 0.75rem;
    color: var(--color-text-light);
  }

  /* ===== Spruce 2-Column Article Layout ===== */
  .article-layout-grid {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 3.5rem;
    align-items: start;
    padding-bottom: 3rem;
  }

  .article-main-col {
    min-width: 0;
    max-width: 820px;
  }

  /* Cover Image */
  .article-cover-wrap {
    margin-bottom: 2rem;
  }

  .cover-image {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    display: block;
    background: #f0f0f0;
  }

  .cover-caption {
    font-size: 0.75rem;
    color: var(--color-text-light);
    line-height: 1.45;
    margin-top: 0.5rem;
    font-style: italic;
  }



  /* Mobile Inline TOC */
  .mobile-toc-card {
    display: none;
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    padding: 1.25rem 1.5rem;
    margin-bottom: 2rem;
  }

  .mobile-toc-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-main);
    margin-bottom: 0.75rem;
  }

  .mobile-toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .mobile-toc-list a {
    font-size: 0.875rem;
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* ===== Prose Styling (The Spruce Magazine Typography) ===== */
  .prose-content {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    line-height: 1.8;
    color: #1a1a1a;
  }

  .prose-content :global(p) {
    margin-bottom: 1.5rem;
  }

  .prose-content :global(p.lead-paragraph) {
    font-size: 1.2rem;
    line-height: 1.7;
    color: #222222;
    font-weight: 400;
    margin-bottom: 2rem;
  }

  .prose-content :global(h2) {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-text-main);
    margin-top: 2.75rem;
    margin-bottom: 1rem;
    line-height: 1.3;
    scroll-margin-top: 120px;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--color-border);
  }

  .prose-content :global(h3) {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-main);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    line-height: 1.35;
  }

  .prose-content :global(ul),
  .prose-content :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .prose-content :global(li) {
    margin-bottom: 0.5rem;
    line-height: 1.65;
  }

  .prose-content :global(a) {
    color: var(--color-accent);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1.5px;
    transition: color 0.15s ease;
  }

  .prose-content :global(a:hover) {
    color: var(--color-accent-hover);
  }

  .prose-content :global(strong),
  .prose-content :global(b) {
    font-weight: 700;
    color: var(--color-text-main);
  }

  /* Pull Quotes (The Spruce Style) */
  .prose-content :global(.editorial-quote) {
    margin: 2.5rem 0;
    padding: 1.75rem 2rem;
    border-top: 2px solid var(--color-accent);
    border-bottom: 2px solid var(--color-accent);
    background-color: var(--color-surface-subtle);
    text-align: center;
  }

  .prose-content :global(.editorial-quote blockquote) {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-style: italic;
    color: var(--color-text-main);
    line-height: 1.55;
    margin-bottom: 0.75rem;
  }

  .prose-content :global(.editorial-quote cite) {
    font-size: 0.75rem;
    font-style: normal;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
  }

  /* Specification Card */
  .prose-content :global(.spec-card) {
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-accent);
    padding: 1.5rem 1.75rem;
    margin: 2.5rem 0;
  }

  .prose-content :global(.spec-card h4) {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-accent);
    margin-bottom: 0.85rem;
  }

  .prose-content :global(.spec-card ul) {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .prose-content :global(.spec-card li) {
    font-size: 0.875rem;
    line-height: 1.5;
    border-bottom: 1px solid #f0f0f0;
    padding-bottom: 0.5rem;
    margin: 0;
  }

  .prose-content :global(.spec-card li:last-child) {
    border-bottom: none;
    padding-bottom: 0;
  }

  /* FAQ Accordion */
  .prose-content :global(.faq-accordion) {
    margin: 2.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .prose-content :global(.faq-item) {
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    padding: 1.25rem 1.5rem;
  }

  .prose-content :global(.faq-item h3) {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-text-main);
    margin: 0 0 0.5rem;
    line-height: 1.4;
  }

  .prose-content :global(.faq-item p) {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0;
  }

  .prose-content :global(.faq-item p strong) {
    color: var(--color-text-main);
  }

  /* Editorial Figures */
  .prose-content :global(.editorial-figure) {
    margin: 2.75rem 0;
    padding: 0;
    background-color: #f7f7f7;
    border: 1px solid var(--color-border);
  }

  .prose-content :global(.editorial-figure img) {
    width: 100%;
    height: auto;
    max-height: 500px;
    object-fit: cover;
    display: block;
  }

  .prose-content :global(.editorial-figure figcaption) {
    padding: 0.85rem 1.15rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    background-color: #ffffff;
    border-top: 1px solid var(--color-border);
    line-height: 1.5;
  }

  .prose-content :global(.editorial-figure figcaption strong) {
    color: var(--color-text-main);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 0.75rem;
    display: inline-block;
    margin-right: 0.35rem;
  }

  /* Fact Check Box */
  .fact-check-box {
    display: flex;
    gap: 1rem;
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    padding: 1.25rem 1.5rem;
    margin: 3rem 0 2rem;
  }

  .fact-icon {
    color: var(--color-accent);
    flex-shrink: 0;
    padding-top: 0.15rem;
  }

  .fact-text h4 {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-main);
    margin-bottom: 0.3rem;
  }

  .fact-text p {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin: 0;
  }

  .bottom-share-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 3rem;
  }

  .bottom-share-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-light);
  }

  /* Author Bio Section */
  .author-bio-card {
    display: flex;
    gap: 1.5rem;
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    padding: 2rem;
    margin-bottom: 2rem;
  }

  .author-bio-avatar {
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .bio-eyebrow {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-light);
    display: block;
    margin-bottom: 0.2rem;
  }

  .author-bio-name {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.2rem;
  }

  .author-bio-name a {
    color: inherit;
    text-decoration: none;
  }

  .author-bio-name a:hover {
    color: var(--color-accent);
  }

  .author-bio-role {
    font-size: 0.75rem;
    color: var(--color-accent);
    font-weight: 600;
    display: block;
    margin-bottom: 0.65rem;
  }

  .author-bio-text {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 0.85rem;
  }

  .author-folio-link {
    font-size: 0.75rem;
