---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Newsletter from '../../components/Newsletter.astro';
import siteData from '../../data/site.json';
import articles from '../../data/articles.json';
import categoryGuides from '../../data/category-guides.json';

export function getStaticPaths() {
  return siteData.categories.map(category => ({
    params: { slug: category.slug },
    props: { category }
  }));
}

const { category } = Astro.props;

const categoryArticles = articles.filter(a => a.category === category.slug);
const featuredCategoryArticle = categoryArticles[0];
const otherArticles = categoryArticles.slice(1);

const categoryGuide = (categoryGuides as Record<string, any>)[category.slug];

const breadcrumbItems = [
  { name: 'Categories', url: '/' },
  { name: category.name }
];
---

<BaseLayout
  title={`${category.title} | Atrium Livings`}
  description={category.description}
  image={category.cover}
  breadcrumbs={breadcrumbItems}
  jsonLdType="website"
>
  <Breadcrumbs items={breadcrumbItems} />

  <!-- Category Hero Header -->
  <header class="category-header">
    <div class="container">
      <div class="category-header-inner">
        <span class="category-kicker">Architectural Focus</span>
        <h1 class="category-title">{category.name}</h1>
        <p class="category-lead">{category.description}</p>

        <div class="category-meta-bar">
          <span class="article-count">{categoryArticles.length} Curated Guides</span>
          <span class="meta-dot">&bull;</span>
          <span class="editorial-status">Peer-Reviewed Specifications</span>
        </div>
      </div>
    </div>
  </header>

  <!-- Articles Grid -->
  <section class="category-content-section">
    <div class="container">
      {featuredCategoryArticle && (
        <div class="category-featured-box">
          <span class="featured-banner-tag">Category Feature Story</span>
          <ArticleCard article={featuredCategoryArticle} variant="featured" />
        </div>
      )}

      {otherArticles.length > 0 && (
        <div class="category-secondary-grid">
          {otherArticles.map(art => (
            <ArticleCard article={art} variant="standard" />
          ))}
        </div>
      )}

      {categoryArticles.length === 0 && (
        <div class="empty-category-notice">
          <p>Our editorial team is currently drafting the upcoming master volume for {category.name}.</p>
          <a href="/" class="btn-primary">Return to Magazine Home</a>
        </div>
      )}

      <!-- Comprehensive Category Architectural Guidelines (SEO Rich) -->
      {categoryGuide && (
        <section class="category-architectural-guide">
          <div class="guide-card">
            <span class="guide-kicker">Spatial Field Guide & Specifications</span>
            <h2 class="guide-title">{categoryGuide.title || `${category.name} Architectural Rules & Material Standards`}</h2>
            <p class="guide-intro">
              Designing in the {category.name.toLowerCase()} domain demands an exacting synthesis of structural framing, atmospheric lighting kelvins, acoustic insulation, and tactile materiality. The following criteria govern our editorial evaluations, project critiques, and contractor tolerances:
            </p>

            <div class="guide-grid">
              {categoryGuide.sections.map((sec: any) => (
                <div class="guide-col">
                  <h3>{sec.heading}</h3>
                  <p>{sec.text}</p>
                </div>
              ))}
            </div>
          </div>
        </section>
      )}
    </div>
  </section>

  <!-- Newsletter -->
  <div class="container">
    <Newsletter />
  </div>
</BaseLayout>

<style>
  .category-header {
    background-color: var(--color-surface-subtle);
    border-bottom: 1px solid var(--color-border);
    padding: 3.5rem 0 3rem;
    text-align: center;
  }

  .category-header-inner {
    max-width: 760px;
    margin: 0 auto;
  }

  .category-kicker {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
    display: block;
    margin-bottom: 0.5rem;
  }

  .category-title {
    font-family: var(--font-serif);
    font-size: 3rem;
    font-weight: 700;
    color: var(--color-text-main);
    line-height: 1.15;
    margin-bottom: 1rem;
  }

  .category-lead {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .category-meta-bar {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-light);
    background: #FFFFFF;
    padding: 0.35rem 1rem;
    border-radius: 9999px;
    border: 1px solid var(--color-border);
  }

  .category-content-section {
    padding: 3rem 0;
  }

  .category-featured-box {
    margin-bottom: 4rem;
    padding-bottom: 3.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .featured-banner-tag {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 1.25rem;
  }

  .category-secondary-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
  }

  .empty-category-notice {
    text-align: center;
    padding: 4rem 1rem;
    background: var(--color-surface);
    border: 1px dashed var(--color-border);
    border-radius: 6px;
  }

  .empty-category-notice p {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .category-architectural-guide {
    margin-top: 4.5rem;
    padding-top: 3.5rem;
    border-top: 1px solid var(--color-border);
  }

  .guide-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 3rem;
  }

  .guide-kicker {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.75rem;
  }

  .guide-title {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-text-main);
    line-height: 1.25;
    margin-bottom: 1rem;
  }

  .guide-intro {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 2.5rem;
    max-width: 820px;
  }

  .guide-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .guide-col {
    background: var(--color-surface-subtle);
    padding: 1.75rem;
    border-radius: 6px;
    border: 1px solid var(--color-border);
  }

  .guide-col h3 {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text-main);
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .guide-col p {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  @media (max-width: 900px) {
    .category-title {
      font-size: 2.25rem;
    }
    .category-secondary-grid {
      grid-template-columns: 1fr;
    }
    .guide-card {
      padding: 1.75rem 1.25rem;
    }
    .guide-grid {
      grid-template-columns: 1fr;
    }
  }
</style>