---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Newsletter from '../../components/Newsletter.astro';
import siteData from '../../data/site.json';
import articles from '../../data/articles.json';
import categoryGuides from '../../data/categoryGuides.json';

export function getStaticPaths() {
  return siteData.categories.map(category => ({
    params: { slug: category.slug },
    props: { category }
  }));
}

const { category } = Astro.props;

const categoryArticles = articles.filter(a => a.category === category.slug);
const featuredCategoryArticle = categoryArticles[0];
const otherArticles = categoryArticles.slice(1);

const relatedSpacesArticles = articles
  .filter(a => a.category !== category.slug)
  .slice(0, 3);

const otherCategories = siteData.categories
  .filter(c => c.slug !== category.slug)
  .slice(0, 8);

const guide = (categoryGuides as Record<string, any>)[category.slug] || null;

const breadcrumbItems = [
  { name: 'Categories', url: '/' },
  { name: category.name }
];
---

<BaseLayout
  title={category.title}
  description={category.description}
  image={category.cover}
  breadcrumbs={breadcrumbItems}
  jsonLdType="website"
>
  <Breadcrumbs items={breadcrumbItems} />

  <!-- Category header -->
  <header class="category-header">
    <div class="container">
      <div class="category-header-inner">
        <div class="category-header-text">
          <span class="category-eyebrow">Design & Home Guide</span>
          <h1 class="category-h1">{category.name}</h1>
          <p class="category-desc">{category.description}</p>
          <span class="category-count">{categoryArticles.length} article{categoryArticles.length !== 1 ? 's' : ''}</span>
        </div>
        <div class="category-header-image">
          <img
            src={category.cover}
            alt={category.name}
            width="480"
            height="320"
            loading="eager"
            fetchpriority="high"
            class="category-cover-img"
            crossorigin="anonymous"
            referrerpolicy="no-referrer-when-downgrade"
          />
        </div>
      </div>
    </div>
  </header>

  <!-- Main content -->
  <section class="category-main">
    <div class="container">

      <!-- Cover story: hero layout -->
      {featuredCategoryArticle && (
        <div class="cat-section">
          <div class="section-bar">
            <span class="section-bar-label">Cover Story</span>
            <div class="section-bar-line"></div>
          </div>
          <ArticleCard article={featuredCategoryArticle} variant="hero" priority={true} />
        </div>
      )}

      <!-- Grid of other articles -->
      {otherArticles.length > 0 && (
        <div class="cat-section">
          <div class="section-bar">
            <span class="section-bar-label">All {category.name} Guides</span>
            <div class="section-bar-line"></div>
          </div>
          <div class="articles-three-col">
            {otherArticles.map(art => (
              <ArticleCard article={art} variant="standard" />
            ))}
          </div>
        </div>
      )}

      {categoryArticles.length === 0 && (
        <div class="empty-notice">
          <p>Our editorial team is preparing upcoming guides for {category.name}.</p>
          <a href="/" class="btn-primary">Return to Home</a>
        </div>
      )}

      <!-- Category guide monograph -->
      {guide && (
        <div class="cat-section monograph-section">
          <div class="section-bar">
            <span class="section-bar-label">Expert Guide</span>
            <div class="section-bar-line"></div>
          </div>
          <div class="monograph-layout">
            <div class="monograph-text">
              <h2 class="monograph-h2">{guide.scopeTitle}</h2>
              <p class="monograph-p">{guide.scopeParagraph1}</p>
              <p class="monograph-p">{guide.scopeParagraph2}</p>

              <h3 class="monograph-h3">{guide.materialTitle}</h3>
              <p class="monograph-p">{guide.materialParagraph}</p>

              <div class="monograph-checklist">
                <h4 class="checklist-title">Key Planning Checklist</h4>
                <ul class="checklist-list">
                  {guide.keyRules.map((rule: string) => (
                    <li>{rule}</li>
                  ))}
                </ul>
              </div>
            </div>

            <aside class="monograph-specs">
              <div class="specs-card">
                <span class="specs-eyebrow">Specifications</span>
                <h3 class="specs-h3">Tolerances & Standards</h3>
                <dl class="specs-dl">
                  {guide.engineeringSpecs.map((spec: { label: string; value: string }) => (
                    <div class="spec-row">
                      <dt class="spec-dt">{spec.label}</dt>
                      <dd class="spec-dd">{spec.value}</dd>
                    </div>
                  ))}
                </dl>
                <p class="specs-note">Curated by the Atrium Livings home decor and styling team.</p>
              </div>
            </aside>
          </div>
        </div>
      )}

      <!-- More from other categories -->
      {relatedSpacesArticles.length > 0 && (
        <div class="cat-section">
          <div class="section-bar">
            <span class="section-bar-label">More Guides You May Like</span>
            <div class="section-bar-line"></div>
          </div>
          <div class="articles-three-col">
            {relatedSpacesArticles.map(art => (
              <ArticleCard article={art} variant="standard" />
            ))}
          </div>
        </div>
      )}

      <!-- Browse other topics -->
      <div class="cat-section browse-topics">
        <div class="section-bar">
          <span class="section-bar-label">Browse All Topics</span>
          <div class="section-bar-line"></div>
        </div>
        <div class="topic-chips">
          {otherCategories.map(cat => (
            <a href={`/category/${cat.slug}/`} class="topic-chip">
              {cat.name}
            </a>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- Newsletter -->
  <Newsletter />

</BaseLayout>

<style>
  /* Category header */
  .category-header {
    background-color: var(--color-surface-subtle);
    border-bottom: 1px solid var(--color-border);
    padding: 2.5rem 0;
    margin-bottom: 3rem;
  }

  .category-header-inner {
    display: grid;
    grid-template-columns: 1fr 420px;
    gap: 2.5rem;
    align-items: center;
  }

  .category-eyebrow {
    display: block;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }

  .category-h1 {
    font-family: var(--font-serif);
    font-size: 2.75rem;
    font-weight: 700;
    color: var(--color-text-main);
    line-height: 1.15;
    margin-bottom: 0.85rem;
    letter-spacing: -0.01em;
  }

  .category-desc {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 1rem;
    max-width: 560px;
  }

  .category-count {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-light);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border: 1px solid var(--color-border);
    padding: 0.3rem 0.75rem;
    border-radius: 20px;
  }

  .category-cover-img {
    width: 100%;
    height: 260px;
    object-fit: cover;
    display: block;
  }

  /* Main section */
  .category-main {
    padding-bottom: 3rem;
  }

  .cat-section {
    margin-bottom: 3.5rem;
  }

  /* Section bar */
  .section-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .section-bar-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-main);
    white-space: nowrap;
    padding-bottom: 0.4rem;
    border-bottom: 2px solid var(--color-text-main);
  }

  .section-bar-line {
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  /* Article grids */
  .articles-three-col {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  /* Monograph guide */
  .monograph-section {
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    padding: 2rem;
  }

  .monograph-layout {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 2.5rem;
    align-items: start;
  }

  .monograph-h2 {
    font-family: var(--font-serif);
    font-size: 1.65rem;
    font-weight: 700;
    color: var(--color-text-main);
    margin-bottom: 1rem;
    line-height: 1.3;
  }

  .monograph-h3 {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-text-main);
    margin: 1.5rem 0 0.75rem;
  }

  .monograph-p {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.75;
    margin-bottom: 1rem;
  }

  .monograph-checklist {
    margin-top: 1.5rem;
    padding: 1.5rem;
    background: #ffffff;
    border: 1px solid var(--color-border);
  }

  .checklist-title {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-main);
    margin-bottom: 0.85rem;
  }

  .checklist-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 0;
  }

  .checklist-list li {
    font-size: 0.9rem;
    color: var(--color-text-main);
    padding-left: 1.35rem;
    position: relative;
    line-height: 1.55;
  }

  .checklist-list li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--color-accent);
    font-weight: 700;
  }

  /* Specs card */
  .specs-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    padding: 1.5rem;
    position: sticky;
    top: 2rem;
  }

  .specs-eyebrow {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    display: block;
    margin-bottom: 0.4rem;
  }

  .specs-h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text-main);
    margin-bottom: 1.25rem;
  }

  .specs-dl {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    margin-bottom: 1.25rem;
  }

  .spec-row {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.75rem;
  }

  .spec-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .spec-dt {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    margin-bottom: 0.2rem;
  }

  .spec-dd {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text-main);
    margin: 0;
  }

  .specs-note {
    font-size: 0.75rem;
    color: var(--color-text-light);
    line-height: 1.5;
    font-style: italic;
    border-top: 1px dashed var(--color-border);
    padding-top: 0.85rem;
  }

  /* Browse topics */
  .browse-topics {}

  .topic-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .topic-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-main);
    border: 1.5px solid var(--color-border);
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .topic-chip:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  /* Empty */
  .empty-notice {
    text-align: center;
    padding: 4rem 1rem;
    background: var(--color-surface-subtle);
    border: 1px dashed var(--color-border);
    margin-bottom: 3rem;
  }

  .empty-notice p {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  /* Responsive */
  @media (max-width: 960px) {
    .category-header-inner {
      grid-template-columns: 1fr;
    }
    .category-h1 {
      font-size: 2.1rem;
    }
    .monograph-layout {
      grid-template-columns: 1fr;
    }
    .specs-card {
      position: static;
    }
    .category-cover-img {
      height: 220px;
    }
  }

  @media (max-width: 700px) {
    .articles-three-col {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
    .category-h1 {
      font-size: 1.75rem;
    }
  }

  @media (max-width: 480px) {
    .articles-three-col {
      grid-template-columns: 1fr;
    }
  }
</style>