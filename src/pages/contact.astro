---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbItems = [
  { name: 'Contact & Submissions' }
];
---

<BaseLayout
  title="Contact Atrium Livings | Editorial Inquiries"
  description="Connect with the editorial team at Atrium Livings. Submit residential project pitches, photography portfolios, press releases, or licensing inquiries."
  breadcrumbs={breadcrumbItems}
  jsonLdType="organization"
>
  <Breadcrumbs items={breadcrumbItems} />

  <section class="contact-hero">
    <div class="container contact-container">
      <span class="contact-kicker">Connect With Us</span>
      <h1 class="contact-headline">Editorial Inquiries & Home Submissions</h1>
      <p class="contact-lead">
        We welcome home tours, DIY project pitches, room makeover stories, and reader styling questions.
      </p>
    </div>
  </section>

  <section class="contact-section">
    <div class="container contact-grid">
      <!-- Contact Info / Bureaus -->
      <div class="contact-info-col">
        <h2 class="col-title">Publishing Desk</h2>

        <div class="info-block">
          <h3>Editorial Desk</h3>
          <p>
            Atrium Livings Media Group<br />
            742 Montgomery St, Suite 400<br />
            San Francisco, CA 94111 &bull; USA<br />
            Email: <a href="mailto:intouchmagazines26@gmail.com">intouchmagazines26@gmail.com</a>
          </p>
        </div>

        <div class="info-block">
          <h3>Direct Desk Inquiries</h3>
          <ul class="contacts-list">
            <li><strong>General Inquiries & Submissions:</strong> <a href="mailto:intouchmagazines26@gmail.com">intouchmagazines26@gmail.com</a></li>
            <li><strong>Editorial & Corrections:</strong> <a href="mailto:intouchmagazines26@gmail.com">intouchmagazines26@gmail.com</a></li>
            <li><strong>Advertising & Partnerships:</strong> <a href="mailto:intouchmagazines26@gmail.com">intouchmagazines26@gmail.com</a></li>
          </ul>
        </div>
      </div>

      <!-- Submission Interactive Form -->
      <div class="contact-form-col">
        <div class="form-card">
          <h2 class="form-card-title">Send a Message or Project Pitch</h2>
          <p class="form-card-desc">Our editors review all messages within two business days.</p>

          <form class="contact-form" onsubmit="event.preventDefault(); document.getElementById('contactFeedback').style.display = 'block'; this.reset();">
            <div class="form-group">
              <label for="contactName">Your Name *</label>
              <input type="text" id="contactName" required placeholder="e.g. Maya Lin" class="form-input" />
            </div>

            <div class="form-group">
              <label for="contactEmail">Email Address *</label>
              <input type="email" id="contactEmail" required placeholder="name@example.com" class="form-input" />
            </div>

            <div class="form-group">
              <label for="inquiryType">Inquiry Topic *</label>
              <select id="inquiryType" required class="form-select">
                <option value="project-submission">Home Tour or DIY Project Submission</option>
                <option value="editorial-letter">Letter to the Editor / Decor Question</option>
                <option value="press-release">Press Release / Product Review</option>
                <option value="advertising">Advertising & Brand Sponsorship</option>
                <option value="correction">Editorial Correction / Feedback</option>
              </select>
            </div>

            <div class="form-group">
              <label for="projectLink">Photo Link / Portfolio URL (Optional)</label>
              <input type="url" id="projectLink" placeholder="https://..." class="form-input" />
            </div>

            <div class="form-group">
              <label for="contactMessage">Message / Project Details *</label>
              <textarea id="contactMessage" rows="5" required placeholder="Please describe your home decor project, DIY makeover, or question..." class="form-textarea"></textarea>
            </div>

            <button type="submit" class="btn-primary form-submit-btn">Send Message</button>

            <div id="contactFeedback" class="form-feedback">
              Thank you. Your message has been received by the Atrium Livings editorial team.
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <section class="contact-guidelines-section">
    <div class="container contact-guidelines-container">
      <div class="guidelines-card">
        <span class="guidelines-kicker">Submission Guidelines</span>
        <h2 class="guidelines-title">Home Tour & DIY Submission Guidelines</h2>
        <p class="guidelines-lead">
          Atrium Livings celebrates real homes, creative DIY tutorials, and inspiring room makeovers. We love spaces that show warmth, personality, and practical creativity.
        </p>

        <div class="guidelines-grid">
          <div class="guideline-col">
            <h3>1. Photography & Room Views</h3>
            <p>
              Submissions should include clear, high-resolution photos capturing overall room layouts, before-and-after views, and close-up styling details with good natural light.
            </p>
          </div>
          <div class="guideline-col">
            <h3>2. Project Steps & Materials</h3>
            <p>
              For DIY submissions, please include the step-by-step process, tools needed, paint color names, and approximate budget or cost breakdown.
            </p>
          </div>
          <div class="guideline-col">
            <h3>3. Full Credits & Sources</h3>
            <p>
              Please provide credits for the homeowner, decorator, DIY maker, and photographer, along with any key product sources readers might ask about.
            </p>
          </div>
          <div class="guideline-col">
            <h3>4. Review Process</h3>
            <p>
              Our editorial team reviews submissions on a rolling basis. We will reach out if your home or DIY project is selected for a feature in our magazine!
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-hero {
    background-color: var(--color-surface-subtle);
    border-bottom: 1px solid var(--color-border);
    padding: 4.5rem 0 3.5rem;
    text-align: center;
  }

  .contact-container {
    max-width: 820px;
  }

  .contact-kicker {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-accent);
    display: block;
    margin-bottom: 0.75rem;
  }

  .contact-headline {
    font-family: var(--font-serif);
    font-size: 2.85rem;
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 1.25rem;
  }

  .contact-lead {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .contact-section {
    padding: 5rem 0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 4rem;
  }

  .col-title {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 2rem;
  }

  .info-block {
    margin-bottom: 2.25rem;
  }

  .info-block h3 {
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .info-block p {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .contacts-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .form-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 2.5rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.03);
  }

  .form-card-title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .form-card-desc {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-group label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-main);
  }

  .form-input, .form-select, .form-textarea {
    width: 100%;
    padding: 0.8rem 1rem;
    font-size: 0.9375rem;
    border: 1px solid var(--color-border-dark);
    border-radius: 4px;
    background-color: #FFFFFF;
    color: var(--color-text-main);
    outline: none;
    font-family: inherit;
  }

  .form-input:focus, .form-select:focus, .form-textarea:focus {
    border-color: var(--color-dark);
  }

  .form-submit-btn {
    align-self: flex-start;
    padding: 0.9rem 2rem;
  }

  .form-feedback {
    display: none;
    margin-top: 1.5rem;
    padding: 1rem 1.25rem;
    background-color: #E8F0E6;
    color: #2D5A27;
    border-radius: 4px;
    font-size: 0.9375rem;
    font-weight: 500;
  }

  /* Submission Guidelines Styles */
  .contact-guidelines-section {
    padding: 0 0 5rem;
  }

  .guidelines-card {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 3rem 2.5rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
  }

  .guidelines-kicker {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-accent);
    display: block;
    margin-bottom: 0.5rem;
  }

  .guidelines-title {
    font-family: var(--font-serif);
    font-size: 2rem;
    color: var(--color-text-main);
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .guidelines-lead {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-text-muted);
    margin-bottom: 2.5rem;
    max-width: 800px;
  }

  .guidelines-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem;
    border-top: 1px solid var(--color-border);
    padding-top: 2rem;
  }

  .guideline-col h3 {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--color-text-main);
    margin-bottom: 0.75rem;
  }

  .guideline-col p {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  @media (max-width: 800px) {
    .guidelines-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
    .guidelines-card {
      padding: 2rem 1.25rem;
    }
  }

  @media (max-width: 850px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>