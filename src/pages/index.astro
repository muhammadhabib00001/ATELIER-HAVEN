---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Newsletter from '../components/Newsletter.astro';
import siteData from '../data/site.json';
import articles from '../data/articles.json';

// Sort articles chronologically descending
const sortedArticles = [...articles].sort((a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime());

// Cover Article (Featured story)
const coverArticle = sortedArticles.find(a => a.featured) || sortedArticles[0] || null;

// Secondary Spotlight Articles (for the top hero sidebar)
const secondaryHeroArticles = coverArticle 
  ? sortedArticles.filter(a => a.slug !== coverArticle.slug).slice(0, 2)
  : [];

// Editorial Showcase Grid:
// If <= 4 total articles, display all articles in the showcase grid so visitors always see rich content!
// If > 4 articles, display articles excluding the cover story.
const gridArticles = sortedArticles.length <= 4 
  ? sortedArticles 
  : sortedArticles.filter(a => a.slug !== coverArticle?.slug);

const categories = siteData.categories;
const featuredCategories = categories.slice(0, 6);
const authors = siteData.authors;
---

<BaseLayout
  title="Atrium Livings | Home Decor, Styling & DIY Magazine"
  description="Discover expert home decor ideas, practical DIY projects, room makeovers, and master interior styling guides from Atrium Livings Magazine."
  jsonLdType="website"
>

  <!-- 1. Masthead / Editorial Cover Story Hero -->
  {coverArticle && (
    <section class="magazine-hero-section">
      <div class="container">
        <div class={`magazine-hero-grid ${secondaryHeroArticles.length === 0 ? 'hero-single-column' : ''}`}>
          
          <!-- Left: Grand Cover Story -->
          <article class="cover-story-card">
            <a href={`/${coverArticle.slug}/`} class="cover-img-link" aria-label={coverArticle.title}>
              <div class="cover-img-wrap">
                <img
                  src={coverArticle.coverImage}
                  alt={coverArticle.coverAlt || coverArticle.title}
                  loading="eager"
                  fetchpriority="high"
                  width="1200"
                  height="800"
                  class="cover-img"
                  crossorigin="anonymous"
                  referrerpolicy="no-referrer-when-downgrade"
                />
                <div class="cover-img-gradient"></div>
                <div class="cover-badges">
                  <span class="cover-kicker-badge">Featured Cover Story</span>
                  <span class="cover-cat-badge">
                    {categories.find(c => c.slug === coverArticle.category)?.name || coverArticle.category}
                  </span>
                </div>
              </div>
            </a>
            
            <div class="cover-body">
              <div class="cover-meta-bar">
                <span class="cover-readtime">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                  {coverArticle.readTime}
                </span>
                <span class="meta-separator">&bull;</span>
                <span class="cover-date">
                  {new Date(coverArticle.publishedAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
                </span>
              </div>

              <h1 class="cover-headline">
                <a href={`/${coverArticle.slug}/`}>{coverArticle.title}</a>
              </h1>

              <p class="cover-excerpt">{coverArticle.subtitle}</p>

              <div class="cover-footer">
                {(() => {
                  const author = authors.find(a => a.slug === coverArticle.author) || authors[0];
                  return (
                    <div class="cover-author-pill">
                      <img 
                        src={author.avatar} 
                        alt={author.name} 
                        class="author-avatar-img" 
                        width="40" 
                        height="40" 
                        crossorigin="anonymous"
                      />
                      <div class="author-text">
                        <span class="author-name">By <a href={`/author/${author.slug}/`}>{author.name}</a></span>
                        <span class="author-role">{author.role}</span>
                      </div>
                    </div>
                  );
                })()}

                <a href={`/${coverArticle.slug}/`} class="cover-cta-btn">
                  <span>Read Full Guide</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
              </div>
            </div>
          </article>

          <!-- Right: Issue Spotlight Card(s) -->
          {secondaryHeroArticles.length > 0 && (
            <aside class="hero-sidebar-spotlight">
              <div class="spotlight-header-bar">
                <span class="spotlight-kicker">Issue Spotlight</span>
                <span class="spotlight-counter">{secondaryHeroArticles.length} Companion Guide{secondaryHeroArticles.length > 1 ? 's' : ''}</span>
              </div>

              <div class="spotlight-cards-stack">
                {secondaryHeroArticles.map(art => {
                  const artAuthor = authors.find(a => a.slug === art.author) || authors[0];
                  return (
                    <article class="spotlight-card">
                      <a href={`/${art.slug}/`} class="spotlight-img-link" aria-label={art.title}>
                        <div class="spotlight-img-wrap">
                          <img
                            src={art.coverImage}
                            alt={art.coverAlt || art.title}
                            loading="eager"
                            width="600"
                            height="400"
                            class="spotlight-img"
                            crossorigin="anonymous"
                            referrerpolicy="no-referrer-when-downgrade"
                          />
                          <span class="spotlight-tag">
                            {categories.find(c => c.slug === art.category)?.name || art.category}
                          </span>
                        </div>
                      </a>
                      <div class="spotlight-content">
                        <div class="spotlight-meta">
                          <span class="spotlight-read">{art.readTime}</span>
                          <span class="meta-dot">&bull;</span>
                          <span class="spotlight-date">
                            {new Date(art.publishedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                          </span>
                        </div>
                        <h2 class="spotlight-title">
                          <a href={`/${art.slug}/`}>{art.title}</a>
                        </h2>
                        <p class="spotlight-desc">{art.subtitle}</p>
                        <div class="spotlight-author-row">
                          <img 
                            src={artAuthor.avatar} 
                            alt={artAuthor.name} 
                            class="spotlight-author-img" 
                            width="26" 
                            height="26" 
                            crossorigin="anonymous"
                          />
                          <span class="spotlight-author-name">By {artAuthor.name}</span>
                          <a href={`/${art.slug}/`} class="spotlight-arrow-link" aria-label={`Read ${art.title}`}>
                            Read &rarr;
                          </a>
                        </div>
                      </div>
                    </article>
                  );
                })}
              </div>
            </aside>
          )}

        </div>
      </div>
    </section>
  )}

  <!-- 2. Curated Topic Strip -->
  <section class="topic-navigation-strip">
    <div class="container">
      <div class="topic-strip-inner">
        <span class="topic-strip-label">Explore Topics:</span>
        <div class="topic-pills-scroll">
          {categories.map(cat => (
            <a href={`/category/${cat.slug}/`} class="topic-pill">
              {cat.name}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Featured Editorial Masterclasses Grid -->
  <section class="editorial-grid-section">
    <div class="container">
      <div class="section-title-bar">
        <div class="title-bar-left">
          <span class="section-eyebrow">Curated Masterclasses</span>
          <h2 class="section-heading">Featured In-Depth Interior Guides</h2>
        </div>
        <a href="/category/bedroom/" class="section-view-all">Browse All Guides &rarr;</a>
      </div>

      <div class="editorial-cards-grid">
        {gridArticles.map(art => {
          const artAuthor = authors.find(a => a.slug === art.author) || authors[0];
          const artCat = categories.find(c => c.slug === art.category) || { name: art.category, slug: art.category };
          return (
            <article class="magazine-grid-card">
              <a href={`/${art.slug}/`} class="card-img-link" aria-label={art.title}>
                <div class="card-img-wrap">
                  <img
                    src={art.coverImage}
                    alt={art.coverAlt || art.title}
                    loading="lazy"
                    decoding="async"
                    width="800"
                    height="533"
                    class="card-img"
                    crossorigin="anonymous"
                    referrerpolicy="no-referrer-when-downgrade"
                  />
                  <span class="card-cat-badge">{artCat.name}</span>
                  {art.featured && <span class="card-featured-badge">Editor's Choice</span>}
                </div>
              </a>

              <div class="card-body-content">
                <div class="card-meta-top">
                  <span class="card-read-pill">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                    {art.readTime}
                  </span>
                  <span class="meta-dot">&bull;</span>
                  <span class="card-date-str">
                    {new Date(art.publishedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                  </span>
                </div>

                <h3 class="card-headline">
                  <a href={`/${art.slug}/`}>{art.title}</a>
                </h3>

                <p class="card-excerpt-text">{art.subtitle}</p>

                {art.keyTakeaways && art.keyTakeaways.length > 0 && (
                  <div class="card-highlights-preview">
                    <span class="highlight-bullet">Master Formula:</span>
                    <p class="highlight-snippet">{art.keyTakeaways[0]}</p>
                  </div>
                )}

                <div class="card-footer-byline">
                  <div class="author-micro-block">
                    <img 
                      src={artAuthor.avatar} 
                      alt={artAuthor.name} 
                      class="author-micro-avatar" 
                      width="30" 
                      height="30" 
                      crossorigin="anonymous"
                    />
                    <div class="author-micro-info">
                      <span class="author-micro-name">{artAuthor.name}</span>
                      <span class="author-micro-title">{artAuthor.role}</span>
                    </div>
                  </div>
                  <a href={`/${art.slug}/`} class="card-read-link">
                    Read Guide &rarr;
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- 4. Master Craftsman Editorial Standards Block -->
  <section class="editorial-standards-banner">
    <div class="container">
      <div class="standards-card">
        <div class="standards-header">
          <div class="standards-crest">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <div class="standards-text">
            <span class="standards-kicker">The Atrium Livings Standard</span>
            <h2 class="standards-title">Field-Tested, Human-Crafted Editorial Journalism</h2>
            <p class="standards-sub">
              We never publish automated AI fluff or vague decorating advice. Every guide is developed with master craftsman precision: verified perimeter clearances, Kelvin color temperature balancing, and tactile material integrity.
            </p>
          </div>
        </div>

        <div class="standards-pillars-grid">
          <div class="pillar-item">
            <div class="pillar-number">01</div>
            <h3 class="pillar-title">36-Inch Walkway Standard</h3>
            <p class="pillar-desc">Rigorous spatial clearances tested so living spaces remain open, uncluttered, and comfortable.</p>
          </div>
          <div class="pillar-item">
            <div class="pillar-number">02</div>
            <h3 class="pillar-title">True Kelvin Lighting Formulas</h3>
            <p class="pillar-desc">Precise separation between 2700K evening ambient light and 5500K natural daylight to prevent color pollution.</p>
          </div>
          <div class="pillar-item">
            <div class="pillar-number">03</div>
            <h3 class="pillar-title">Structural Foundation Stability</h3>
            <p class="pillar-desc">Heavyweight platform specifications, longitudinal center rails, and triple vertical support standards.</p>
          </div>
          <div class="pillar-item">
            <div class="pillar-number">04</div>
            <h3 class="pillar-title">100% Human Mastercraft</h3>
            <p class="pillar-desc">Written by senior interior stylists and makers with zero automated filler and zero marketing hype.</p>
          </div>
        </div>

        <div class="standards-footer">
          <a href="/editorial-policy/" class="standards-policy-link">Read our full editorial methodology &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Curated Room Collections (Visual Category Showcase) -->
  <section class="room-collections-section">
    <div class="container">
      <div class="section-title-bar">
        <div class="title-bar-left">
          <span class="section-eyebrow">Spaces & Rooms</span>
          <h2 class="section-heading">Browse In-Depth Collections</h2>
        </div>
      </div>

      <div class="rooms-grid">
        {featuredCategories.map(cat => (
          <a href={`/category/${cat.slug}/`} class="room-card">
            <div class="room-img-wrap">
              <img
                src={cat.cover}
                alt={cat.name}
                loading="lazy"
                width="600"
                height="400"
                class="room-img"
                crossorigin="anonymous"
              />
              <div class="room-img-overlay"></div>
              <div class="room-info">
                <h3 class="room-title">{cat.name}</h3>
                <p class="room-desc">{cat.description}</p>
                <span class="room-explore-link">Explore Collection &rarr;</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. In-Depth Articles Stream with Editorial Sidebar -->
  <section class="magazine-stream-section">
    <div class="container">
      <div class="stream-layout-grid">
        
        <!-- Main Column: All Published Masterclasses -->
        <div class="stream-main-col">
          <div class="section-title-bar">
            <div class="title-bar-left">
              <span class="section-eyebrow">Reading Room</span>
              <h2 class="section-heading">All Published Guides & Articles</h2>
            </div>
          </div>

          <div class="stream-articles-feed">
            {sortedArticles.map(art => {
              const artAuthor = authors.find(a => a.slug === art.author) || authors[0];
              const artCat = categories.find(c => c.slug === art.category) || { name: art.category, slug: art.category };
              return (
                <article class="stream-card">
                  <a href={`/${art.slug}/`} class="stream-img-link" aria-label={art.title}>
                    <div class="stream-img-wrap">
                      <img
                        src={art.coverImage}
                        alt={art.coverAlt || art.title}
                        loading="lazy"
                        width="500"
                        height="333"
                        class="stream-img"
                        crossorigin="anonymous"
                        referrerpolicy="no-referrer-when-downgrade"
                      />
                      <span class="stream-cat-pill">{artCat.name}</span>
                    </div>
                  </a>

                  <div class="stream-content">
                    <div class="stream-meta">
                      <span class="stream-readtime">{art.readTime}</span>
                      <span class="meta-dot">&bull;</span>
                      <span class="stream-date">
                        {new Date(art.publishedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                      </span>
                    </div>

                    <h3 class="stream-title">
                      <a href={`/${art.slug}/`}>{art.title}</a>
                    </h3>

                    <p class="stream-excerpt">{art.subtitle}</p>

                    <div class="stream-author-row">
                      <img
                        src={artAuthor.avatar}
                        alt={artAuthor.name}
                        class="stream-author-avatar"
                        width="28"
                        height="28"
                        crossorigin="anonymous"
                      />
                      <span class="stream-author-name">By <a href={`/author/${artAuthor.slug}/`}>{artAuthor.name}</a></span>
                      <a href={`/${art.slug}/`} class="stream-read-cta">Read Article &rarr;</a>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        </div>

        <!-- Sidebar: Editorial Staff & Quick Navigation -->
        <aside class="stream-sidebar">
          
          <!-- Senior Editors Widget -->
          <div class="sidebar-box editors-box">
            <h3 class="sidebar-box-title">Editorial Masthead</h3>
            <div class="editors-list">
              {authors.map(author => (
                <a href={`/author/${author.slug}/`} class="editor-item">
                  <img
                    src={author.avatar}
                    alt={author.name}
                    class="editor-avatar"
                    width="44"
                    height="44"
                    crossorigin="anonymous"
                  />
                  <div class="editor-meta">
                    <span class="editor-name">{author.name}</span>
                    <span class="editor-role">{author.role}</span>
                  </div>
                </a>
              ))}
            </div>
          </div>

          <!-- Popular Topics Widget -->
          <div class="sidebar-box">
            <h3 class="sidebar-box-title">Popular Topics</h3>
            <div class="sidebar-topics-list">
              {categories.slice(0, 7).map(cat => (
                <a href={`/category/${cat.slug}/`} class="sidebar-topic-item">
                  <span>{cat.name}</span>
                  <span class="topic-arrow">&rsaquo;</span>
                </a>
              ))}
            </div>
          </div>

          <!-- About Atrium Livings -->
          <div class="sidebar-box about-box">
            <h3 class="sidebar-box-title">About Atrium Livings</h3>
            <p class="about-text">
              Atrium Livings is an independent digital magazine dedicated to masterclass residential interior styling, hands-on DIY carpentry, spatial planning, and timeless decor.
            </p>
            <div class="about-links">
              <a href="/about/" class="about-link">Our Story &rarr;</a>
              <a href="/editorial-policy/" class="about-link">Editorial Policy &rarr;</a>
            </div>
          </div>

        </aside>

      </div>
    </div>
  </section>

  <!-- 7. Inline Newsletter Banner -->
  <Newsletter />

</BaseLayout>

<style>
  /* ==========================================================================
     MAGAZINE THEME HERO SECTION
     ========================================================================== */
  .magazine-hero-section {
    padding: 2rem 0 3rem;
    background-color: #ffffff;
  }

  .magazine-hero-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 2.25rem;
    align-items: stretch;
  }

  .magazine-hero-grid.hero-single-column {
    grid-template-columns: 1fr;
    max-width: 960px;
    margin: 0 auto;
  }

  /* Cover Story Card */
  .cover-story-card {
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border: 1px solid var(--color-border);
    transition: box-shadow 0.25s ease, transform 0.25s ease;
  }

  .cover-story-card:hover {
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.07);
  }

  .cover-img-link {
    display: block;
    text-decoration: none;
    overflow: hidden;
  }

  .cover-img-wrap {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: #f0f0f0;
  }

  .cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease, opacity 0.25s ease;
  }

  .cover-story-card:hover .cover-img {
    transform: scale(1.025);
    opacity: 0.96;
  }

  .cover-img-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.35) 0%,
      transparent 50%
    );
    pointer-events: none;
  }

  .cover-badges {
    position: absolute;
    top: 1rem;
    left: 1rem;
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    z-index: 2;
  }

  .cover-kicker-badge {
    background-color: #1a1a1a;
    color: #ffffff;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.35rem 0.75rem;
  }

  .cover-cat-badge {
    background-color: var(--color-accent);
    color: #ffffff;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.35rem 0.75rem;
  }

  .cover-body {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .cover-meta-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--color-text-light);
    margin-bottom: 0.75rem;
  }

  .cover-readtime {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  .meta-separator {
    color: var(--color-border-dark);
  }

  .cover-headline {
    font-family: var(--font-serif);
    font-size: 1.85rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--color-text-main);
    margin-bottom: 0.85rem;
    letter-spacing: -0.01em;
  }

  .cover-headline a {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .cover-headline a:hover {
    color: var(--color-accent);
  }

  .cover-excerpt {
    font-size: 0.975rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .cover-footer {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
    flex-wrap: wrap;
    gap: 1rem;
  }

  .cover-author-pill {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .author-avatar-img {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    border: 1.5px solid var(--color-border);
  }

  .author-text {
    display: flex;
    flex-direction: column;
  }

  .author-name {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-text-main);
  }

  .author-name a {
    color: inherit;
  }

  .author-name a:hover {
    color: var(--color-accent);
  }

  .author-role {
    font-size: 0.6875rem;
    color: var(--color-text-light);
  }

  .cover-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background-color: var(--color-accent);
    color: #ffffff;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 0.65rem 1.25rem;
    text-decoration: none;
    transition: background-color 0.15s ease, transform 0.15s ease;
  }

  .cover-cta-btn:hover {
    background-color: var(--color-accent-hover);
    color: #ffffff;
    transform: translateX(2px);
  }

  /* Right Spotlight Aside */
  .hero-sidebar-spotlight {
    display: flex;
    flex-direction: column;
    background: #ffffff;
  }

  .spotlight-header-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 0.65rem;
    border-bottom: 2px solid var(--color-text-main);
    margin-bottom: 1.25rem;
  }

  .spotlight-kicker {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-main);
  }

  .spotlight-counter {
    font-size: 0.6875rem;
    color: var(--color-text-light);
    font-weight: 600;
    text-transform: uppercase;
  }

  .spotlight-cards-stack {
    display: flex;
