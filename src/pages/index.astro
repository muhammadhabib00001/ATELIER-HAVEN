---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Newsletter from '../components/Newsletter.astro';
import siteData from '../data/site.json';
import articles from '../data/articles.json';

// Strict deduplication
const usedSlugs = new Set<string>();

// Hero article
const heroArticle = articles.find(a => a.featured) || articles[0] || null;
if (heroArticle) usedSlugs.add(heroArticle.slug);

// Hero right-column stack (3 articles)
const heroStack = articles.filter(a => !usedSlugs.has(a.slug)).slice(0, 3);
heroStack.forEach(a => usedSlugs.add(a.slug));

// Featured row (3 cards)
const featuredRow = articles.filter(a => !usedSlugs.has(a.slug)).slice(0, 3);
featuredRow.forEach(a => usedSlugs.add(a.slug));

// Latest grid (remaining)
const latestArticles = articles.filter(a => !usedSlugs.has(a.slug));

const categories = siteData.categories;
---

<BaseLayout
  title="Atrium Livings | Architecture & Home Design Guide"
  description="Expert home design advice covering architecture, interior planning, kitchen, bathroom, renovation, and outdoor living. Practical guides from certified architects."
  jsonLdType="website"
>

  <!-- Top Hero Section -->
  {heroArticle && (
    <section class="hero-section">
      <div class="container">
        <div class="hero-layout">
          <!-- Left: large hero card -->
          <div class="hero-main">
            <a href={`/${heroArticle.slug}/`} class="hero-image-link">
              <div class="hero-image-wrap">
                <img
                  src={heroArticle.coverImage}
                  alt={heroArticle.coverAlt || heroArticle.title}
                  loading="eager"
                  fetchpriority="high"
                  width="1200"
                  height="800"
                  class="hero-img"
                  crossorigin="anonymous"
                  referrerpolicy="no-referrer-when-downgrade"
                />
                <div class="hero-image-overlay"></div>
                <div class="hero-image-content">
                  <a href={`/category/${heroArticle.category}/`} class="hero-category-badge">
                    {siteData.categories.find(c => c.slug === heroArticle.category)?.name || heroArticle.category}
                  </a>
                  <h1 class="hero-title">
                    <a href={`/${heroArticle.slug}/`}>{heroArticle.title}</a>
                  </h1>
                  <p class="hero-excerpt">{heroArticle.subtitle}</p>
                  <span class="hero-readtime">{heroArticle.readTime}</span>
                </div>
              </div>
            </a>
          </div>

          <!-- Right: stacked articles -->
          <aside class="hero-stack">
            <div class="hero-stack-header">
              <span class="stack-label">Latest</span>
            </div>
            {heroStack.map(art => (
              <div class="stack-item">
                <a href={`/category/${art.category}/`} class="stack-cat">
                  {siteData.categories.find(c => c.slug === art.category)?.name || art.category}
                </a>
                <h3 class="stack-title">
                  <a href={`/${art.slug}/`}>{art.title}</a>
                </h3>
                <span class="stack-time">{art.readTime}</span>
              </div>
            ))}
          </aside>
        </div>
      </div>
    </section>
  )}

  <!-- Category tab strip -->
  <section class="category-tab-strip">
    <div class="container">
      <div class="cat-tabs-scroll">
        {categories.map(cat => (
          <a href={`/category/${cat.slug}/`} class="cat-tab">
            {cat.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured 3-column row -->
  {featuredRow.length > 0 && (
    <section class="featured-row-section">
      <div class="container">
        <div class="section-bar">
          <span class="section-bar-label">Editor's Picks</span>
          <div class="section-bar-line"></div>
        </div>
        <div class="three-col-grid">
          {featuredRow.map(art => (
            <ArticleCard article={art} variant="standard" />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Newsletter inline -->
  <Newsletter />

  <!-- Latest articles section -->
  {latestArticles.length > 0 && (
    <section class="latest-articles-section">
      <div class="container latest-layout">

        <!-- Main article stream -->
        <div class="articles-stream">
          <div class="section-bar">
            <span class="section-bar-label">Latest Articles</span>
            <div class="section-bar-line"></div>
          </div>

          <!-- First article: horizontal layout -->
          {latestArticles.slice(0, 1).map(art => (
            <div class="stream-featured-item latest-article-card">
              <ArticleCard article={art} variant="hero" />
            </div>
          ))}

          <!-- Rest as 2-col grid (first 9 shown to total exactly 10 initial articles) -->
          {latestArticles.slice(1).length > 0 && (
            <div class="stream-two-col" id="latestStreamGrid">
              {latestArticles.slice(1).map((art, idx) => (
                <div class={`latest-article-card ${idx >= 9 ? 'latest-card-hidden' : ''}`}>
                  <ArticleCard article={art} variant="standard" />
                </div>
              ))}
            </div>
          )}

          {latestArticles.length > 10 && (
            <div class="load-more-wrap" id="loadMoreWrap">
              <button id="loadMoreBtn" class="btn-load-more" type="button">
                <span>Load More Articles</span>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
            </div>
          )}
        </div>

        <!-- Sidebar -->
        <aside class="articles-sidebar">
          <!-- Popular topics -->
          <div class="sidebar-widget">
            <div class="sidebar-widget-title">Popular Topics</div>
            <div class="sidebar-topic-list">
              {categories.slice(0, 8).map(cat => (
                <a href={`/category/${cat.slug}/`} class="sidebar-topic-link">
                  <span class="topic-name">{cat.name}</span>
                  <span class="topic-arrow">›</span>
                </a>
              ))}
            </div>
          </div>

          <!-- About widget -->
          <div class="sidebar-widget about-widget">
            <div class="sidebar-widget-title">About This Site</div>
            <p class="sidebar-about-text">
              Atrium Livings publishes expert home design and architecture guides reviewed by certified architects and interior design specialists.
            </p>
            <a href="/about/" class="sidebar-about-link">Learn more about us →</a>
          </div>

          <!-- Trust widget -->
          <div class="sidebar-widget trust-widget">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="trust-icon">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
            <p class="trust-text">
              Every article is reviewed by a licensed architect or certified design professional before publication.
            </p>
            <a href="/editorial-policy/" class="sidebar-about-link">Our editorial process →</a>
          </div>
        </aside>

      </div>
    </section>
  )}

  <script>
    const loadMoreBtn = document.getElementById('loadMoreBtn');
    const loadMoreWrap = document.getElementById('loadMoreWrap');

    loadMoreBtn?.addEventListener('click', () => {
      const hiddenCards = document.querySelectorAll('.latest-article-card.latest-card-hidden');
      const BATCH_SIZE = 10;
      const countToReveal = Math.min(BATCH_SIZE, hiddenCards.length);

      for (let i = 0; i < countToReveal; i++) {
        hiddenCards[i].classList.remove('latest-card-hidden');
      }

      if (document.querySelectorAll('.latest-article-card.latest-card-hidden').length === 0) {
        if (loadMoreWrap) loadMoreWrap.style.display = 'none';
      }
    });
  </script>
</BaseLayout>

<style>
  /* ===== Hero Section ===== */
  .hero-section {
    padding: 1.5rem 0 2.5rem;
  }

  .hero-layout {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 1.5rem;
    align-items: start;
  }

  /* Hero main image card */
  .hero-image-link {
    display: block;
    text-decoration: none;
  }

  .hero-image-wrap {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: #e0e0e0;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.2s ease;
  }

  .hero-image-link:hover .hero-img {
    opacity: 0.96;
  }

  .hero-image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.82) 0%,
      rgba(0, 0, 0, 0.35) 50%,
      transparent 100%
    );
    pointer-events: none;
  }

  .hero-image-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.75rem 1.5rem;
    color: #fff;
  }

  .hero-category-badge {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #86efac;
    margin-bottom: 0.5rem;
    text-decoration: none;
  }

  .hero-category-badge:hover {
    color: #ffffff;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: 1.65rem;
    font-weight: 700;
    line-height: 1.25;
    color: #ffffff;
    margin-bottom: 0.5rem;
  }

  .hero-title a {
    color: #ffffff;
    text-decoration: none;
  }

  .hero-title a:hover {
    text-decoration: underline;
  }

  .hero-excerpt {
    font-size: 0.9rem;
    color: rgba(255,255,255,0.85);
    line-height: 1.5;
    margin-bottom: 0.6rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .hero-readtime {
    font-size: 0.6875rem;
    color: rgba(255,255,255,0.65);
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  /* Right stack */
  .hero-stack {
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--color-border);
    padding-left: 1.5rem;
  }

  .hero-stack-header {
    margin-bottom: 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 2px solid var(--color-text-main);
  }

  .stack-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-main);
  }

  .stack-item {
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .stack-item:last-child {
    border-bottom: none;
  }

  .stack-cat {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    text-decoration: none;
  }

  .stack-cat:hover {
    text-decoration: underline;
  }

  .stack-title {
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--color-text-main);
  }

  .stack-title a {
    color: inherit;
    text-decoration: none;
  }

  .stack-title a:hover {
    color: var(--color-accent);
  }

  .stack-time {
    font-size: 0.6875rem;
    color: var(--color-text-light);
  }

  /* ===== Category Tab Strip ===== */
  .category-tab-strip {
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-subtle);
    padding: 0;
    margin: 1rem 0 2.5rem;
    overflow: hidden;
  }

  .cat-tabs-scroll {
    display: flex;
    overflow-x: auto;
    scrollbar-width: none;
    gap: 0;
  }

  .cat-tabs-scroll::-webkit-scrollbar {
    display: none;
  }

  .cat-tab {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.1rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-decoration: none;
    white-space: nowrap;
    border-bottom: 3px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .cat-tab:hover {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  /* ===== Section bar ===== */
  .section-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .section-bar-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-main);
    white-space: nowrap;
    padding-bottom: 0;
    border-bottom: 2px solid var(--color-text-main);
    padding-bottom: 0.4rem;
  }

  .section-bar-line {
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  /* ===== Featured row ===== */
  .featured-row-section {
    padding: 0 0 2.5rem;
  }

  .three-col-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  /* ===== Latest articles layout ===== */
  .latest-articles-section {
    padding: 0 0 3rem;
  }

  .latest-layout {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 3rem;
    align-items: start;
  }

  .stream-featured-item {
    margin-bottom: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .stream-two-col {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem 1.75rem;
  }

  /* ===== Load More ===== */
  .latest-card-hidden {
    display: none !important;
  }

  .load-more-wrap {
    text-align: center;
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .btn-load-more {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 0.85rem 2.5rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-main);
    background: #ffffff;
    border: 1.5px solid var(--color-border-dark);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-load-more:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: var(--color-surface-subtle);
  }

  /* ===== Sidebar ===== */
  .articles-sidebar {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    position: sticky;
    top: 1.5rem;
  }

  .sidebar-widget {
    border: 1px solid var(--color-border);
    padding: 1.25rem;
    background: #ffffff;
  }

  .sidebar-widget-title {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-main);
    margin-bottom: 0.85rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--color-text-main);
  }

  .sidebar-topic-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .sidebar-topic-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
    transition: color 0.15s ease;
  }

  .sidebar-topic-link:last-child {
    border-bottom: none;
  }

  .sidebar-topic-link:hover {
    color: var(--color-accent);
  }

  .topic-name {
    font-weight: 500;
  }

  .topic-arrow {
    color: var(--color-text-light);
    font-size: 1rem;
  }

  .sidebar-about-text {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }

  .sidebar-about-link {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-accent);
    text-decoration: none;
  }

  .sidebar-about-link:hover {
    text-decoration: underline;
  }

  .trust-widget {
    background-color: var(--color-surface-subtle);
    border-color: var(--color-border);
  }

  .trust-icon {
    color: var(--color-accent);
    margin-bottom: 0.65rem;
  }

  .trust-text {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin-bottom: 0.75rem;
  }

  /* ===== Responsive ===== */
  @media (max-width: 1024px) {
    .latest-layout {
      grid-template-columns: 1fr 240px;
      gap: 2rem;
    }
  }

  @media (max-width: 860px) {
    .hero-layout {
      grid-template-columns: 1fr;
    }
    .hero-stack {
      border-left: none;
      padding-left: 0;
      border-top: 1px solid var(--color-border);
      padding-top: 1.25rem;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }
    .hero-stack-header {
      grid-column: span 3;
      margin-bottom: 0;
    }
    .stack-item {
      border-bottom: none;
      border-right: 1px solid var(--color-border);
      padding-right: 1rem;
    }
    .stack-item:last-child {
      border-right: none;
    }
    .three-col-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .latest-layout {
      grid-template-columns: 1fr;
    }
    .articles-sidebar {
      position: static;
    }
  }

  @media (max-width: 600px) {
    .three-col-grid {
      grid-template-columns: 1fr;
    }
    .stream-two-col {
      grid-template-columns: 1fr;
    }
    .hero-stack {
      grid-template-columns: 1fr;
    }
    .hero-stack-header {
      grid-column: span 1;
    }
    .stack-item {
      border-right: none;
      border-bottom: 1px solid var(--color-border);
    }
    .hero-title {
      font-size: 1.35rem;
    }
  }
</style>