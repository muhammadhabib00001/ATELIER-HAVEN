---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbItems = [
  { name: 'Advertising & FTC Disclaimer' }
];

const lastUpdated = "September 1, 2026";
---

<BaseLayout
  title="Advertising & FTC Disclaimer | Atrium Livings"
  description="Full transparency statement regarding affiliate links, Google AdSense relationships, material testing, and editorial integrity."
  breadcrumbs={breadcrumbItems}
>
  <Breadcrumbs items={breadcrumbItems} />

  <div class="legal-page-container">
    <div class="container legal-content-wrapper">
      <header class="legal-header">
        <span class="legal-kicker">Compliance & Transparency</span>
        <h1 class="legal-title">Advertising & FTC Disclaimer</h1>
        <p class="legal-meta">Effective Date: {lastUpdated} &bull; Atrium Livings Media Group, Inc.</p>
      </header>

      <div class="legal-prose">
        <p class="lead">Atrium Livings operates under strict compliance with the Federal Trade Commission (FTC) Guides Concerning the Use of Endorsements and Testimonials in Advertising (16 CFR Part 255) and Google AdSense publisher quality standards.</p>

        <h2>1. Editorial Independence Guarantee</h2>
        <p>Our editorial coverage is strictly independent. We never accept compensation, complimentary hotel stays, or free building materials in exchange for favorable architectural critiques. When our writers review tile lines, hardwood joinery, or lighting fixtures, assessments are conducted based purely on durability, environmental lifecycle impact, and design excellence.</p>

        <h2>2. Third-Party Advertising & Google AdSense</h2>
        <p>This website displays third-party programmatic advertisements, primarily serviced through the Google AdSense network. These advertisements are automatically selected and populated based on contextual page relevance or algorithmic reader interests.</p>
        <p>The presence of any advertisement on Atrium Livings does NOT constitute an endorsement or warranty of the advertised product or service by our editorial masthead. We proactively filter out deceptive, predatory, or visually disruptive ad categories.</p>

        <h2>3. Affiliate Disclosure & Links</h2>
        <p>Certain articles may occasionally contain affiliate tracking links to architectural monographs, specialized tooling, or certified materials. If you click an affiliate link and subsequently make a purchase, Atrium Livings may receive a modest referral commission at zero additional expense to you.</p>
        <p>Articles containing affiliate links are clearly marked at the head of the story with an unambiguous disclosure statement. We only reference products that our architectural staff would genuinely specify on professional client projects.</p>

        <h2>4. Construction & Renovation Risk Acknowledgment</h2>
        <p>Home remodeling involves inherent physical and financial risks, including but not limited to structural instability, electrical electrocution, hazardous mold, asbestos, and municipal building violations. Readers assume full personal responsibility for verifying all dimensions, engineering calculations, and permits with licensed professionals prior to beginning demolition.</p>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .legal-page-container {
    padding: 4rem 0 6rem;
  }
  .legal-content-wrapper {
    max-width: 800px;
    margin: 0 auto;
  }
  .legal-header {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 2rem;
    margin-bottom: 2.5rem;
  }
  .legal-kicker {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-accent);
    display: block;
    margin-bottom: 0.5rem;
  }
  .legal-title {
    font-family: var(--font-serif);
    font-size: 2.75rem;
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 0.75rem;
  }
  .legal-meta {
    font-size: 0.8125rem;
    color: var(--color-text-light);
  }
  .legal-prose {
    font-size: 1.05rem;
    line-height: 1.75;
    color: #2D2A26;
  }
  .legal-prose .lead {
    font-size: 1.15rem;
    color: var(--color-text-main);
    margin-bottom: 2rem;
  }
  .legal-prose h2 {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 700;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    color: var(--color-text-main);
  }
  .legal-prose p {
    margin-bottom: 1.25rem;
  }
</style>