---
import siteData from '../data/site.json';

interface Props {
  article: any;
  variant?: "standard" | "hero" | "compact" | "horizontal";
  priority?: boolean;
}

const {
  article,
  variant = "standard",
  priority = false
} = Astro.props;

const author = siteData.authors.find(a => a.slug === article.author) || siteData.authors[0];
const category = siteData.categories.find(c => c.slug === article.category) || { name: article.category, slug: article.category };

const formattedDate = new Date(article.publishedAt).toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric'
});
---

<article class={`article-card ${variant}`}>
  <a href={`/${article.slug}`} class="card-media-link" tabindex="-1" aria-hidden="true">
    <div class="card-media-wrapper">
      <img 
        src={article.coverImage} 
        alt={article.coverAlt || article.title} 
        loading={priority ? "eager" : "lazy"}
        decoding="async"
        fetchpriority={priority ? "high" : "auto"}
        width="800"
        height="500"
        class="card-img"
      />
      {article.trending && <span class="trending-badge">Trending</span>}
    </div>
  </a>

  <div class="card-content">
    <div class="card-meta-top">
      <a href={`/category/${category.slug}`} class="card-category">
        {category.name}
      </a>
      <span class="meta-sep">&bull;</span>
      <span class="read-time">{article.readTime}</span>
    </div>

    <h3 class="card-title">
      <a href={`/${article.slug}`}>
        {article.title}
      </a>
    </h3>

    {variant !== "compact" && (
      <p class="card-excerpt">
        {article.subtitle}
      </p>
    )}

    <div class="card-author-footer">
      <a href={`/author/${author.slug}`} class="author-row">
        <img 
          src={author.avatar} 
          alt={author.name} 
          width="28" 
          height="28" 
          loading="lazy" 
          class="author-avatar"
        />
        <div class="author-info">
          <span class="author-name">{author.name}</span>
          <span class="publish-date">{formattedDate}</span>
        </div>
      </a>
    </div>
  </div>
</article>

<style>
  .article-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform 0.2s ease;
  }

  .card-media-wrapper {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: var(--color-surface-subtle);
    border-radius: 4px;
    margin-bottom: 1.15rem;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .article-card:hover .card-img {
    transform: scale(1.03);
  }

  .trending-badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background-color: var(--color-dark);
    color: #FAF9F5;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.25rem 0.6rem;
    border-radius: 2px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.15);
  }

  .card-content {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-meta-top {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 700;
    margin-bottom: 0.65rem;
  }

  .card-category {
    color: var(--color-accent);
  }

  .card-category:hover {
    color: var(--color-accent-hover);
    text-decoration: underline;
  }

  .meta-sep {
    color: var(--color-border-dark);
  }

  .read-time {
    color: var(--color-text-light);
    font-weight: 500;
  }

  .card-title {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-text-main);
    margin-bottom: 0.75rem;
  }

  .card-title a {
    color: inherit;
  }

  .card-title a:hover {
    color: var(--color-accent);
  }

  .card-excerpt {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin-bottom: 1.25rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-author-footer {
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
  }

  .author-row {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .author-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
  }

  .author-info {
    display: flex;
    flex-direction: column;
  }

  .author-name {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-main);
  }

  .publish-date {
    font-size: 0.6875rem;
    color: var(--color-text-light);
  }

  /* Variant: Hero */
  .article-card.hero {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  .article-card.hero .card-media-wrapper {
    aspect-ratio: 16 / 11;
    margin-bottom: 0;
  }

  .article-card.hero .card-title {
    font-size: 2.35rem;
    line-height: 1.15;
    margin-bottom: 1rem;
  }

  .article-card.hero .card-excerpt {
    font-size: 1.05rem;
    -webkit-line-clamp: 3;
    margin-bottom: 1.75rem;
  }

  /* Variant: Horizontal */
  .article-card.horizontal {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 1.5rem;
    align-items: center;
  }

  .article-card.horizontal .card-media-wrapper {
    aspect-ratio: 4 / 3;
    margin-bottom: 0;
  }

  .article-card.horizontal .card-title {
    font-size: 1.15rem;
  }

  /* Variant: Compact */
  .article-card.compact .card-title {
    font-size: 1.05rem;
  }

  @media (max-width: 860px) {
    .article-card.hero {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .article-card.hero .card-title {
      font-size: 1.75rem;
    }
    .article-card.horizontal {
      grid-template-columns: 1fr;
    }
  }
</style>