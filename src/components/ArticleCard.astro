---
import siteData from '../data/site.json';

interface Props {
  article: any;
  variant?: "standard" | "hero" | "compact" | "horizontal";
  priority?: boolean;
}

const {
  article,
  variant = "standard",
  priority = false
} = Astro.props;

const author = siteData.authors.find(a => a.slug === article.author) || siteData.authors[0];
const category = siteData.categories.find(c => c.slug === article.category) || { name: article.category, slug: article.category };

const formattedDate = new Date(article.publishedAt).toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric'
});
---

<article class={`article-card ${variant}`}>
  <a href={`/${article.slug}/`} class="card-image-link" tabindex="-1" aria-hidden="true">
    <div class="card-image-wrap">
      <img
        src={article.coverImage}
        alt={article.coverAlt || article.title}
        loading={priority ? "eager" : "lazy"}
        decoding="async"
        fetchpriority={priority ? "high" : "auto"}
        width="800"
        height="533"
        class="card-img"
        crossorigin="anonymous"
        referrerpolicy="no-referrer-when-downgrade"
      />
      {article.trending && <span class="card-trending-badge">Trending</span>}
    </div>
  </a>

  <div class="card-body">
    <a href={`/category/${category.slug}/`} class="card-category-label">
      {category.name}
    </a>

    <h3 class="card-title">
      <a href={`/${article.slug}/`}>
        {article.title}
      </a>
    </h3>

    {variant !== "compact" && (
      <p class="card-excerpt">{article.subtitle}</p>
    )}

    <div class="card-meta">
      <a href={`/author/${author.slug}/`} class="card-author-name">{author.name}</a>
      <span class="card-meta-sep">&bull;</span>
      <span class="card-date">{formattedDate}</span>
    </div>
  </div>
</article>

<style>
  .article-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  /* Image */
  .card-image-link {
    display: block;
    text-decoration: none;
  }

  .card-image-wrap {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background-color: #f0f0f0;
    margin-bottom: 0.85rem;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.2s ease;
    display: block;
  }

  .article-card:hover .card-img {
    opacity: 0.92;
  }

  .card-trending-badge {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    background-color: var(--color-accent);
    color: #ffffff;
    font-size: 0.5625rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
  }

  /* Body */
  .card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-category-label {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.4rem;
    text-decoration: none;
  }

  .card-category-label:hover {
    text-decoration: underline;
  }

  .card-title {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--color-text-main);
    margin-bottom: 0.5rem;
  }

  .card-title a {
    color: inherit;
    text-decoration: none;
  }

  .card-title a:hover {
    color: var(--color-accent);
  }

  .card-excerpt {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin-bottom: 0.75rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-meta {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    color: var(--color-text-light);
    padding-top: 0.5rem;
  }

  .card-author-name {
    color: var(--color-text-muted);
    font-weight: 600;
    font-size: 0.75rem;
    text-decoration: none;
  }

  .card-author-name:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .card-meta-sep {
    color: var(--color-border-dark);
    font-size: 0.6rem;
  }

  .card-date {
    color: var(--color-text-light);
  }

  /* Hero variant */
  .article-card.hero {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 1.75rem;
    align-items: start;
  }

  .article-card.hero .card-image-wrap {
    aspect-ratio: 3 / 2;
    margin-bottom: 0;
  }

  .article-card.hero .card-title {
    font-size: 1.75rem;
    line-height: 1.25;
    margin-bottom: 0.65rem;
    font-family: var(--font-serif);
  }

  .article-card.hero .card-excerpt {
    font-size: 1rem;
    -webkit-line-clamp: 3;
    margin-bottom: 1rem;
  }

  /* Horizontal variant */
  .article-card.horizontal {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 1rem;
    align-items: start;
  }

  .article-card.horizontal .card-image-wrap {
    aspect-ratio: 4 / 3;
    margin-bottom: 0;
  }

  .article-card.horizontal .card-title {
    font-size: 0.9375rem;
    line-height: 1.3;
  }

  .article-card.horizontal .card-excerpt {
    -webkit-line-clamp: 2;
    font-size: 0.8125rem;
    margin-bottom: 0.4rem;
  }

  /* Compact variant */
  .article-card.compact .card-title {
    font-size: 0.9375rem;
  }

  @media (max-width: 720px) {
    .article-card.hero {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .article-card.hero .card-title {
      font-size: 1.35rem;
    }
    .article-card.horizontal {
      grid-template-columns: 1fr;
    }
  }
</style>