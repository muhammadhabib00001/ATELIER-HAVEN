          </svg>
        </a>
        <a href="https://instagram.com/atelierhaven" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Editorial Niches -->
    <div class="footer-col">
      <span class="footer-col-heading">Living Spaces</span>
      <ul class="footer-nav">
        <li><a href="/category/kitchen">Kitchen Design & Islands</a></li>
        <li><a href="/category/bathroom">Bathroom Floor Tiles & Plans</a></li>
        <li><a href="/category/living-room">Japandi Living Rooms</a></li>
        <li><a href="/category/bedroom">Acoustic Bedroom Suites</a></li>
        <li><a href="/category/home-decor">Curated Art & Textiles</a></li>
        <li><a href="/category/small-spaces">Micro-Luxury Small Spaces</a></li>
      </ul>
    </div>

    <!-- Craft & Execution -->
    <div class="footer-col">
      <span class="footer-col-heading">Architecture & Craft</span>
      <ul class="footer-nav">
        <li><a href="/category/furniture">Sustainable Hardwood Joinery</a></li>
        <li><a href="/category/lighting">2700K Architectural Lighting</a></li>
        <li><a href="/category/renovation">Realistic Renovation Budgets</a></li>
        <li><a href="/category/diy">Roman Plaster & Limewash</a></li>
        <li><a href="/category/garden-outdoor">Courtyard Terraces & Atria</a></li>
        <li><a href="/category/design-trends">Quiet Luxury Forecast 2026</a></li>
      </ul>
    </div>

    <!-- Publication & Legal -->
    <div class="footer-col">
      <span class="footer-col-heading">Trust & Governance</span>
      <ul class="footer-nav">
        <li><a href="/about">About Atelier Haven</a></li>
        <li><a href="/editorial-policy">Editorial Standards & Fact-Check</a></li>
        <li><a href="/contact">Pitch & Press Contact</a></li>
        <li><a href="/privacy-policy">Privacy Policy (GDPR / CCPA)</a></li>
        <li><a href="/terms">Terms of Service</a></li>
        <li><a href="/cookie-policy">Cookie Preferences</a></li>
        <li><a href="/disclaimer">Advertising & FTC Disclosures</a></li>
      </ul>
    </div>
  </div>

  <!-- Bottom legal bar -->
  <div class="footer-bottom">
    <div class="container footer-bottom-flex">
      <div class="footer-copy">
        &copy; {currentYear} Atelier Haven Media Group, Inc. All rights reserved. Registered architectural publication.
      </div>
      <div class="footer-ai-disclosure">
        <a href="/llms.txt" class="llm-badge" title="Machine-readable site manifest for LLMs & AI search engines">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="16 18 22 12 16 6"></polyline>
            <polyline points="8 6 2 12 8 18"></polyline>
          </svg>
          /llms.txt Crawlable
        </a>
        <a href="/rss.xml" class="rss-link">RSS Feed</a>
        <a href="/sitemap-index.xml" class="sitemap-link">Sitemap</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
    margin-top: 5rem;
    padding-top: 4rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1.2fr 1.2fr 1.4fr;
    gap: 3rem;
    padding-bottom: 3.5rem;
  }

  .footer-logo {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    color: var(--color-text-main);
    display: block;
    margin-bottom: 1rem;
  }

  .footer-mission {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1.25rem;
    max-width: 320px;
  }

  .badge-issn {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--color-text-light);
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }

  .footer-social {
    display: flex;
    gap: 1rem;
    color: var(--color-text-muted);
  }

  .footer-social a:hover {
    color: var(--color-accent);
  }

  .footer-col-heading {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-main);
    margin-bottom: 1.25rem;
  }

  .footer-nav {
    list-style: none;
  }

  .footer-nav li {
    margin-bottom: 0.65rem;
  }

  .footer-nav a {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .footer-nav a:hover {
    color: var(--color-accent);
  }

  .footer-bottom {
    background-color: var(--color-surface-subtle);
    border-top: 1px solid var(--color-border);
    padding: 1.25rem 0;
    font-size: 0.75rem;
    color: var(--color-text-light);
  }

  .footer-bottom-flex {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-ai-disclosure {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .llm-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: #EAE6DC;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    font-family: monospace;
    font-size: 0.75rem;
    color: var(--color-dark);
    font-weight: 600;
  }

  .llm-badge:hover {
    background: var(--color-dark);
    color: #FAF9F5;
  }

  .rss-link, .sitemap-link {
    color: var(--color-text-muted);
  }

  .rss-link:hover, .sitemap-link:hover {
    color: var(--color-accent);
  }

  @media (max-width: 992px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
    .brand-col {
      grid-column: span 2;
    }
  }

  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .brand-col {
      grid-column: span 1;
    }
  }
</style>