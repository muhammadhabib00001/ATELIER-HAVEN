---
import siteData from '../data/site.json';

const currentYear = new Date().getFullYear();
const categories = siteData.categories;
---

<footer class="site-footer">
  <div class="container footer-grid">
    <!-- Brand / Mission -->
    <div class="footer-col brand-col">
      <span class="footer-logo">ATELIER HAVEN</span>
      <p class="footer-mission">
        An independent architectural and interior design journal curating the finest modern spaces, bespoke craft, and sustainable renovation principles.
      </p>
      <div class="footer-meta-badges">
        <span class="badge-issn">ISSN 2984-1184 &bull; Global Architecture Edition</span>
      </div>
      <div class="footer-social">
        <a href="https://twitter.com/atelierhaven" target="_blank" rel="noopener noreferrer" aria-label="Twitter">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </a>
        <a href="https://pinterest.com/atelierhaven" target="_blank" rel="noopener noreferrer" aria-label="Pinterest">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
