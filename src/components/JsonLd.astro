---
interface Props {
  type: "website" | "article" | "breadcrumbs" | "organization";
  data?: any;
}

const { type, data = {} } = Astro.props;
const siteUrl = "https://atriumlivings.com";

let schema: any = {};

if (type === "organization" || type === "website") {
  schema = {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": `${siteUrl}/#organization`,
        "name": "Atrium Livings",
        "url": siteUrl,
        "logo": {
          "@type": "ImageObject",
          "@id": `${siteUrl}/#logo`,
          "url": `${siteUrl}/images/logo.png`,
          "caption": "Atrium Livings Logo"
        },
        "sameAs": [
          "https://twitter.com/atriumlivings",
          "https://pinterest.com/atriumlivings",
          "https://instagram.com/atriumlivings"
        ],
        "description": "Your Inspiring Digital Magazine for Home Decor, DIY Projects & Creative Living."
      },
      {
        "@type": "WebSite",
        "@id": `${siteUrl}/#website`,
        "url": siteUrl,
        "name": "Atrium Livings",
        "publisher": {
          "@id": `${siteUrl}/#organization`
        },
        "potentialAction": {
          "@type": "SearchAction",
          "target": {
            "@type": "EntryPoint",
            "urlTemplate": `${siteUrl}/search?q={search_term_string}`
          },
          "query-input": "required name=search_term_string"
        }
      }
    ]
  };
} else if (type === "article") {
  const article = data.article;
  const author = data.author;

  // Extract FAQs from article.content if present for Google FAQ Rich Snippets (High CTR)
  const faqItems: Array<{ question: string; answer: string }> = [];
  if (article && article.content) {
    const faqBlockMatch = article.content.match(/<div class=['"]faq-accordion['"]>([\s\S]*?)<\/div>/i);
    if (faqBlockMatch) {
      const itemMatches = [...faqBlockMatch[1].matchAll(/<div class=['"]faq-item['"]>[\s]*<h3>([\s\S]*?)<\/h3>[\s]*<p>([\s\S]*?)<\/p>[\s]*<\/div>/gi)];
      for (const m of itemMatches) {
        const q = m[1].replace(/<[^>]+>/g, '').trim();
        const a = m[2].replace(/<[^>]+>/g, '').trim();
        if (q && a) {
          faqItems.push({ question: q, answer: a });
        }
      }
    }
  }

  const articleSchema: any = {
    "@type": "Article",
    "@id": `${siteUrl}/${article.slug}/#article`,
    "isPartOf": {
      "@type": "WebPage",
      "@id": `${siteUrl}/${article.slug}/`
    },
    "headline": article.title,
    "description": article.seoDescription || article.subtitle,
    "image": [article.coverImage],
    "datePublished": article.publishedAt,
    "dateModified": article.updatedAt || article.publishedAt,
    "mainEntityOfPage": `${siteUrl}/${article.slug}/`,
    "author": {
      "@type": "Person",
      "name": author.name,
      "jobTitle": author.role,
      "url": `${siteUrl}/author/${author.slug}/`,
      "knowsAbout": author.credentials
    },
    "publisher": {
      "@type": "Organization",
      "name": "Atrium Livings",
      "url": siteUrl,
      "logo": {
        "@type": "ImageObject",
        "url": `${siteUrl}/images/logo.png`
      }
    },
    "articleSection": article.category,
    "keywords": article.keywords ? article.keywords.join(", ") : undefined
  };

  const graphElements: any[] = [articleSchema];

  if (faqItems.length > 0) {
    graphElements.push({
      "@type": "FAQPage",
      "@id": `${siteUrl}/${article.slug}/#faq`,
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.answer
        }
      }))
    });
  }

  schema = {
    "@context": "https://schema.org",
    "@graph": graphElements
  };
} else if (type === "breadcrumbs") {
  const items = data.items || [];
  schema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": items.map((item: any, index: number) => ({
      "@type": "ListItem",
      "position": index + 1,
      "name": item.name,
      "item": item.url ? (item.url.startsWith("http") ? item.url : `${siteUrl}${item.url}`) : undefined
    }))
  };
}
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />