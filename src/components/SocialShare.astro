---
interface Props {
  url: string;
  title: string;
  description?: string;
}

const { url, title, description = "" } = Astro.props;

const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
---

<div class="social-share" aria-label="Share this story">
  <span class="share-label">Share Story:</span>

  <!-- Twitter / X -->
  <a 
    href={`https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}&via=atelierhaven`}
    target="_blank" 
    rel="noopener noreferrer"
    aria-label="Share on X"
    class="share-btn twitter"
  >
    <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
    </svg>
  </a>

  <!-- Pinterest -->
  <a 
    href={`https://pinterest.com/pin/create/button/?url=${encodedUrl}&description=${encodedTitle}`}
    target="_blank" 
    rel="noopener noreferrer"
    aria-label="Pin on Pinterest"
    class="share-btn pinterest"
  >
    <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345-.09.375-.293 1.199-.334 1.366-.053.225-.177.268-.409.16-1.523-.71-2.474-2.936-2.474-4.726 0-3.85 2.798-7.39 8.067-7.39 4.236 0 7.529 3.018 7.529 7.054 0 4.21-2.654 7.6-6.337 7.6-1.238 0-2.402-.644-2.801-1.406l-.763 2.91c-.276 1.059-1.026 2.388-1.528 3.199C9.888 23.776 10.918 24 12 24c6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/>
    </svg>
  </a>

  <!-- Facebook -->
  <a 
    href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`}
    target="_blank" 
    rel="noopener noreferrer"
    aria-label="Share on Facebook"
    class="share-btn facebook"
  >
    <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
      <path d="M9 8H6v4h3v12h5V12h3.642L18 8h-4V6.333C14 5.374 14.5 5 15.6 5H18V0h-3.808C10.595 0 9 1.582 9 4.615V8z"/>
    </svg>
  </a>

  <!-- LinkedIn -->
  <a 
    href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`}
    target="_blank" 
    rel="noopener noreferrer"
    aria-label="Share on LinkedIn"
    class="share-btn linkedin"
  >
    <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
      <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
    </svg>
  </a>

  <!-- Copy Link -->
  <button id="copyShareBtn" class="share-btn copy-link" aria-label="Copy article link">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
    </svg>
    <span id="copyFeedback" class="copy-feedback">Copied</span>
  </button>
</div>

<style>
  .social-share {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    position: relative;
  }

  .share-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-light);
    margin-right: 0.25rem;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background-color: var(--color-surface);
    color: var(--color-text-muted);
    transition: all 0.15s ease;
    cursor: pointer;
  }

  .share-btn:hover {
    color: var(--color-dark);
    border-color: var(--color-text-main);
    transform: translateY(-1px);
  }

  .copy-link {
    position: relative;
  }

  .copy-feedback {
    display: none;
    position: absolute;
    top: -28px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-dark);
    color: #FAF9F5;
    font-size: 0.625rem;
    padding: 0.2rem 0.5rem;
    border-radius: 3px;
    white-space: nowrap;
    font-weight: 600;
  }

  .copy-feedback.show {
    display: block;
  }
</style>

<script>
  const copyBtn = document.getElementById('copyShareBtn');
  const feedback = document.getElementById('copyFeedback');
  if (copyBtn && feedback) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        feedback.classList.add('show');
        setTimeout(() => {
          feedback.classList.remove('show');
        }, 2000);
      } catch (err) {
        console.error('Failed to copy', err);
      }
    });
  }
</script>