---
import siteData from '../data/site.json';

const currentPath = Astro.url.pathname;
const allCategories = siteData.categories;

// Standard editorial layout: 7 primary categories in the main bar, remaining in "More" dropdown
const primaryCategories = allCategories.slice(0, 7);
const moreCategories = allCategories.slice(7);

const isMoreActive = moreCategories.some(cat => currentPath.startsWith(`/category/${cat.slug}`)) || currentPath.startsWith('/about');
---

<header class="site-header">

  <!-- 1. Top Utility Bar -->
  <div class="top-bar">
    <div class="container top-bar-inner">
      <div class="top-bar-left">
        <span class="top-bar-tagline">Home Decor Inspiration, DIY Projects & Creative Living</span>
      </div>
      <div class="top-bar-right">
        <a href="https://pinterest.com/atriumlivings" target="_blank" rel="noopener noreferrer" aria-label="Pinterest" class="top-social">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345-.09.375-.293 1.199-.334 1.366-.053.225-.177.268-.409.16-1.523-.71-2.474-2.936-2.474-4.726 0-3.85 2.798-7.39 8.067-7.39 4.236 0 7.529 3.018 7.529 7.054 0 4.21-2.654 7.6-6.337 7.6-1.238 0-2.402-.644-2.801-1.406l-.763 2.91c-.276 1.059-1.026 2.388-1.528 3.199C9.888 23.776 10.918 24 12 24c6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/></svg>
        </a>
        <a href="https://instagram.com/atriumlivings" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="top-social">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        </a>
        <a href="https://twitter.com/atriumlivings" target="_blank" rel="noopener noreferrer" aria-label="Twitter/X" class="top-social">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <span class="top-bar-divider"></span>
        <a href="/search" class="top-search-link" aria-label="Search articles">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <span class="top-search-text">Search</span>
        </a>
      </div>
    </div>
  </div>

  <!-- 2. Main Brand Bar (True Centered Grid) -->
  <div class="header-brand-bar">
    <div class="container header-brand-inner">
      <!-- Left side: Mobile menu toggle -->
      <div class="header-left-slot">
        <button id="mobileMenuBtn" aria-label="Open navigation menu" class="menu-toggle-btn">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
      </div>

      <!-- Center: Wordmark Brand -->
      <div class="header-center-slot">
        <a href="/" class="brand-link" aria-label="Atrium Livings Home">
          <span class="brand-name">ATRIUM<span class="brand-name-second"> LIVINGS</span></span>
          <span class="brand-tagline">Home Decor &bull; DIY &bull; Living</span>
        </a>
      </div>

      <!-- Right side: Search & Subscribe -->
      <div class="header-right-slot">
        <a href="/search" class="header-search-pill" aria-label="Search articles">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <span class="search-pill-text">Search</span>
        </a>
        <a href="#newsletter" class="header-subscribe-btn">Subscribe</a>
      </div>
    </div>
  </div>

  <!-- 3. Standard Editorial Navigation Bar -->
  <nav class="header-nav" aria-label="Primary Navigation">
    <div class="container">
      <ul class="nav-list" id="navCategories">
        <li class="nav-item">
          <a href="/" class={`nav-link ${currentPath === '/' ? 'active' : ''}`}>Home</a>
        </li>
        {primaryCategories.map(cat => (
          <li class="nav-item">
            <a
              href={`/category/${cat.slug}/`}
              class={`nav-link ${currentPath.startsWith(`/category/${cat.slug}`) ? 'active' : ''}`}
            >
              {cat.name}
            </a>
          </li>
        ))}
        <!-- "More" Dropdown Menu -->
        <li class="nav-item has-dropdown">
          <button class={`nav-link dropdown-toggle ${isMoreActive ? 'active' : ''}`} aria-expanded="false" aria-haspopup="true">
            <span>More</span>
            <svg class="dropdown-chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <div class="dropdown-menu" role="menu">
            {moreCategories.map(cat => (
              <a href={`/category/${cat.slug}/`} class={`dropdown-item ${currentPath.startsWith(`/category/${cat.slug}`) ? 'active-item' : ''}`} role="menuitem">
                {cat.name}
              </a>
            ))}
            <div class="dropdown-divider"></div>
            <a href="/about/" class={`dropdown-item ${currentPath.startsWith('/about') ? 'active-item' : ''}`} role="menuitem">
              About Us
            </a>
            <a href="/editorial-policy/" class="dropdown-item" role="menuitem">
              Editorial Policy
            </a>
          </div>
        </li>
      </ul>
    </div>
  </nav>

  <!-- 4. Mobile Navigation Drawer -->
  <div class="mobile-drawer" id="mobileDrawer" aria-hidden="true">
    <div class="drawer-header">
      <span class="drawer-brand">ATRIUM LIVINGS</span>
      <button id="closeDrawerBtn" aria-label="Close navigation menu" class="drawer-close-btn">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="drawer-body">
      <!-- Search inside Drawer -->
      <form action="/search" method="GET" class="drawer-search-form">
        <input type="search" name="q" placeholder="Search guides & articles..." required aria-label="Search" class="drawer-search-input" />
        <button type="submit" aria-label="Submit search" class="drawer-search-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>
      </form>

      <div class="drawer-section-label">All Categories</div>
      <ul class="drawer-links">
        <li><a href="/" class={currentPath === '/' ? 'active-drawer-link' : ''}>Home</a></li>
        {allCategories.map(cat => (
          <li>
            <a
              href={`/category/${cat.slug}/`}
              class={currentPath.startsWith(`/category/${cat.slug}`) ? 'active-drawer-link' : ''}
            >
              {cat.name}
            </a>
          </li>
        ))}
      </ul>

      <div class="drawer-section-label">About & Information</div>
      <ul class="drawer-links secondary">
        <li><a href="/about/">About Us</a></li>
        <li><a href="/editorial-policy/">Editorial Policy</a></li>
        <li><a href="/contact/">Contact Us</a></li>
        <li><a href="/privacy-policy/">Privacy Policy</a></li>
        <li><a href="/terms/">Terms of Use</a></li>
      </ul>
    </div>
  </div>

  <div class="drawer-overlay" id="drawerOverlay"></div>

</header>

<style>
  /* ===== 1. Top Utility Bar ===== */
  .top-bar {
    background-color: #1a1a1a;
    color: #d0d0d0;
    font-size: 0.75rem;
    border-bottom: 1px solid #2d2d2d;
    padding: 0.45rem 0;
  }

  .top-bar-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .top-bar-tagline {
    font-size: 0.75rem;
    color: #9ca3af;
    letter-spacing: 0.04em;
    font-weight: 500;
  }

  .top-bar-right {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .top-social {
    color: #9ca3af;
    display: flex;
    align-items: center;
    transition: color 0.15s ease;
  }

  .top-social:hover {
    color: #ffffff;
  }

  .top-bar-divider {
    width: 1px;
    height: 12px;
    background-color: #4b5563;
  }

  .top-search-link {
    color: #9ca3af;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .top-search-link:hover {
    color: #ffffff;
  }

  /* ===== 2. Main Brand Bar (3-Column Centered Layout) ===== */
  .header-brand-bar {
    background-color: #ffffff;
    border-bottom: 1px solid var(--color-border);
    padding: 1.15rem 0;
  }

  .header-brand-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
  }

  .header-left-slot {
    display: flex;
    align-items: center;
  }

  .menu-toggle-btn {
    display: none;
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--color-text-main);
    padding: 0.35rem;
    border-radius: 4px;
    align-items: center;
    justify-content: center;
    transition: color 0.15s ease;
  }

  .menu-toggle-btn:hover {
    color: var(--color-accent);
  }

  .header-center-slot {
    display: flex;
    justify-content: center;
  }

  .brand-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    line-height: 1;
    gap: 0.25rem;
  }

  .brand-name {
    font-family: var(--font-brand);
    font-size: 2.15rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    color: #1a1a1a;
    line-height: 1;
  }

  .brand-name-second {
    color: var(--color-accent);
    font-weight: 600;
  }

  .brand-tagline {
    font-size: 0.5625rem;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-text-light);
    line-height: 1;
  }

  .header-right-slot {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.85rem;
  }

  .header-search-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    padding: 0.5rem 0.95rem;
    border-radius: 20px;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .header-search-pill:hover {
    border-color: var(--color-text-main);
    color: var(--color-text-main);
  }

  .header-subscribe-btn {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.55rem 1.25rem;
    background-color: var(--color-accent);
    color: #ffffff;
    border-radius: 3px;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .header-subscribe-btn:hover {
    background-color: var(--color-accent-hover);
    color: #ffffff;
  }

  /* ===== 3. Standard Category Navigation Bar ===== */
  .header-nav {
    background-color: #ffffff;
    border-bottom: 1px solid var(--color-border);
  }

  .nav-list {
    display: flex;
    list-style: none;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    padding: 0;
    margin: 0;
    flex-wrap: wrap;
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-muted);
    padding: 0.75rem 0.95rem;
    text-decoration: none;
    border-bottom: 3px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
    background: transparent;
    border-top: none;
    border-left: none;
    border-right: none;
    cursor: pointer;
    white-space: nowrap;
    line-height: 1.2;
  }

  .nav-link:hover {
    color: var(--color-text-main);
    border-bottom-color: var(--color-text-main);
  }

  .nav-link.active {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  /* Dropdown Menu */
  .has-dropdown {
    position: relative;
  }

  .dropdown-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .dropdown-chevron {
    transition: transform 0.2s ease;
  }

  .has-dropdown:hover .dropdown-chevron,
  .has-dropdown:focus-within .dropdown-chevron {
    transform: rotate(180deg);
  }

  .dropdown-menu {
    position: absolute;
    top: 100%;
    right: 0;
    min-width: 210px;
    background: #ffffff;
    border: 1px solid var(--color-border);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
    padding: 0.5rem 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s ease;
    z-index: 100;
  }

  .has-dropdown:hover .dropdown-menu,
  .has-dropdown:focus-within .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-item {
    display: block;
    padding: 0.6rem 1.25rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text-main);
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .dropdown-item:hover,
  .dropdown-item.active-item {
    background: var(--color-surface-subtle);
    color: var(--color-accent);
  }

  .dropdown-divider {
    height: 1px;
    background: var(--color-border);
    margin: 0.4rem 0;
  }

  /* ===== 4. Mobile Drawer ===== */
  .mobile-drawer {
    position: fixed;
    top: 0;
    left: 0;
    width: 320px;
    max-width: 85vw;
    height: 100vh;
    background-color: #ffffff;
    z-index: 200;
    display: flex;
    flex-direction: column;
    transform: translateX(-100%);
    transition: transform 0.28s ease;
    box-shadow: 4px 0 24px rgba(0, 0, 0, 0.15);
    overflow-y: auto;
  }

  .mobile-drawer.open {
    transform: translateX(0);
  }

  .drawer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .drawer-brand {
    font-family: var(--font-brand);
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--color-text-main);
  }

  .drawer-close-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.25rem;
    color: var(--color-text-muted);
  }

  .drawer-close-btn:hover {
    color: var(--color-text-main);
  }

  .drawer-body {
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .drawer-search-form {
    display: flex;
    border: 1px solid var(--color-border);
    background: var(--color-surface-subtle);
  }

  .drawer-search-input {
    flex: 1;
    border: none;
    background: transparent;
    padding: 0.65rem 0.85rem;
    font-size: 0.875rem;
    outline: none;
    color: var(--color-text-main);
  }

  .drawer-search-btn {
    background: transparent;
    border: none;
    padding: 0.65rem 0.85rem;
    cursor: pointer;
    color: var(--color-text-muted);
  }

  .drawer-section-label {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-light);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.35rem;
  }

  .drawer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .drawer-links li a {
    display: block;
    padding: 0.65rem 0;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text-main);
    text-decoration: none;
    border-bottom: 1px solid #f3f3f3;
    transition: color 0.15s ease;
  }

  .drawer-links li a:hover,
  .drawer-links li a.active-drawer-link {
    color: var(--color-accent);
  }

  .drawer-links.secondary li a {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .drawer-overlay {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.45);
    z-index: 150;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }

  .drawer-overlay.show {
    opacity: 1;
    visibility: visible;
  }

  /* ===== Responsive Breakpoints ===== */
  @media (max-width: 992px) {
    .menu-toggle-btn {
      display: inline-flex;
    }

    .header-nav {
      display: none;
    }

    .top-bar-tagline {
      display: none;
    }

    .search-pill-text {
      display: none;
    }

    .header-search-pill {
      padding: 0.45rem;
      border-radius: 50%;
    }
  }

  @media (max-width: 600px) {
    .brand-name {
      font-size: 1.55rem;
      letter-spacing: 0.1em;
    }

    .brand-tagline {
      display: none;
    }

    .header-subscribe-btn {
      font-size: 0.75rem;
      padding: 0.45rem 0.85rem;
    }
  }
</style>

<script>
  const mobileBtn = document.getElementById('mobileMenuBtn');
  const closeBtn = document.getElementById('closeDrawerBtn');
  const drawer = document.getElementById('mobileDrawer');
  const overlay = document.getElementById('drawerOverlay');

  function openDrawer() {
    drawer?.classList.add('open');
    overlay?.classList.add('show');
    drawer?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    drawer?.classList.remove('open');
    overlay?.classList.remove('show');
    drawer?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  mobileBtn?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  overlay?.addEventListener('click', closeDrawer);

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer?.classList.contains('open')) {
      closeDrawer();
    }
  });
</script>