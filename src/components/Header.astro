---
import siteData from '../data/site.json';

const currentPath = Astro.url.pathname;
const categories = siteData.categories;
---

<header class="site-header">

  <!-- Main branding bar -->
  <div class="header-main">
    <div class="container header-main-grid">
      <div class="header-mobile-toggle">
        <button id="mobileMenuBtn" aria-label="Toggle navigation menu" class="icon-button">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
      </div>

      <div class="header-brand">
        <a href="/" class="brand-link">
          <span class="brand-title">ATELIER HAVEN</span>
          <span class="brand-tagline">Architectural &bull; Interior &bull; Living</span>
        </a>
      </div>

      <div class="header-actions">
        <a href="/search" class="search-trigger" aria-label="Search articles">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <span class="search-label">Search Index</span>
        </a>
        <a href="#newsletter" class="subscribe-btn">Subscribe</a>
      </div>
    </div>
  </div>

  <!-- Primary navigation categories -->
  <nav class="header-nav" aria-label="Primary Navigation">
    <div class="container">
      <ul class="nav-list" id="navCategories">
        <li class="nav-item">
          <a href="/" class={`nav-link ${currentPath === '/' ? 'active' : ''}`}>Home</a>
        </li>
        {categories.slice(0, 8).map(cat => (
          <li class="nav-item">
            <a href={`/category/${cat.slug}`} class={`nav-link ${currentPath.startsWith(`/category/${cat.slug}`) ? 'active' : ''}`}>
              {cat.name}
            </a>
          </li>
        ))}
        <li class="nav-item dropdown-item">
          <button class="nav-link dropdown-toggle" aria-expanded="false" id="moreDropdownBtn">
            More Spaces
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <div class="dropdown-menu" id="moreDropdownMenu">
            {categories.slice(8).map(cat => (
              <a href={`/category/${cat.slug}`} class="dropdown-link">
                <span class="dropdown-name">{cat.name}</span>
              </a>
            ))}
          </div>
        </li>
      </ul>
    </div>
  </nav>

  <!-- Mobile Drawer -->
  <div class="mobile-drawer" id="mobileDrawer">
    <div class="drawer-header">
      <span class="drawer-brand">ATELIER HAVEN</span>
      <button id="closeDrawerBtn" aria-label="Close menu" class="icon-button">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <div class="drawer-body">
      <div class="drawer-section-title">Design Niches</div>
      <ul class="drawer-links">
        <li><a href="/">Home</a></li>
        {categories.map(cat => (
          <li>
            <a href={`/category/${cat.slug}`}>
              {cat.name}
            </a>
          </li>
        ))}
      </ul>
      <div class="drawer-section-title">Publication</div>
      <ul class="drawer-links secondary">
        <li><a href="/about">About & Mission</a></li>
        <li><a href="/contact">Contact & Pitches</a></li>
        <li><a href="/editorial-policy">Editorial Standards</a></li>
        <li><a href="/sitemap-index.xml">XML Sitemap</a></li>
      </ul>
    </div>
  </div>
</header>

<style>
  .site-header {
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .header-main {
    padding: 1.25rem 0;
  }

  .header-main-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }

  .header-mobile-toggle {
    display: none;
  }

  .header-brand {
    text-align: center;
    grid-column: 2;
  }

  .brand-link {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .brand-title {
    font-family: var(--font-serif);
    font-size: 2.2rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    color: var(--color-text-main);
    line-height: 1.1;
  }

  .brand-tagline {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.28em;
    color: var(--color-text-light);
    margin-top: 0.35rem;
    font-weight: 500;
  }

  .header-actions {
    grid-column: 3;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 1.25rem;
  }

  .search-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-muted);
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    background-color: var(--color-bg);
  }

  .search-trigger:hover {
    border-color: var(--color-text-main);
    color: var(--color-text-main);
  }

  .subscribe-btn {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.5rem 1rem;
    background-color: var(--color-dark);
    color: #FAF9F5;
    border-radius: 3px;
  }

  .subscribe-btn:hover {
    background-color: var(--color-accent);
  }

  .icon-button {
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--color-text-main);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.25rem;
  }

  .header-nav {
    border-top: 1px solid var(--color-border);
    background-color: var(--color-surface);
  }

  .nav-list {
    display: flex;
    list-style: none;
    justify-content: center;
    align-items: center;
    gap: 1.75rem;
    padding: 0.65rem 0;
    position: relative;
  }

  .nav-link {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    text-transform: uppercase;
    padding: 0.25rem 0;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    background: transparent;
    border: none;
    cursor: pointer;
  }

  .nav-link:hover, .nav-link.active {
    color: var(--color-accent);
  }

  .dropdown-item {
    position: relative;
  }

  .dropdown-menu {
    display: none;
    position: absolute;
    top: 100%;
    right: 0;
    background-color: var(--color-surface);
    min-width: 200px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.08);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 0.5rem 0;
    z-index: 100;
  }

  .dropdown-item:hover .dropdown-menu,
  .dropdown-menu.show {
    display: block;
  }

  .dropdown-link {
    display: block;
    padding: 0.5rem 1.25rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text-main);
  }

  .dropdown-link:hover {
    background-color: var(--color-surface-subtle);
    color: var(--color-accent);
  }

  /* Mobile drawer */
  .mobile-drawer {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 300px;
    height: 100vh;
    background-color: var(--color-surface);
    border-right: 1px solid var(--color-border);
    box-shadow: 10px 0 30px rgba(0,0,0,0.1);
    z-index: 100;
    flex-direction: column;
    padding: 1.5rem;
    transform: translateX(-100%);
    transition: transform 0.3s ease;
  }

  .mobile-drawer.open {
    display: flex;
    transform: translateX(0);
  }

  .drawer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .drawer-brand {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: 0.1em;
  }

  .drawer-body {
    overflow-y: auto;
    padding-top: 1rem;
  }

  .drawer-section-title {
    font-size: 0.6875rem;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--color-text-light);
    letter-spacing: 0.12em;
    margin: 1rem 0 0.5rem;
  }

  .drawer-links {
    list-style: none;
  }

  .drawer-links li a {
    display: block;
    padding: 0.6rem 0;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text-main);
    border-bottom: 1px solid rgba(0,0,0,0.03);
  }

  .drawer-links.secondary li a {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 992px) {
    .header-main-grid {
      display: flex;
      justify-content: space-between;
    }

    .header-mobile-toggle {
      display: block;
    }

    .brand-title {
      font-size: 1.6rem;
    }

    .header-nav {
      display: none;
    }

    .search-label {
      display: none;
    }
  }
</style>

<script>
  const mobileBtn = document.getElementById('mobileMenuBtn');
  const closeBtn = document.getElementById('closeDrawerBtn');
  const drawer = document.getElementById('mobileDrawer');

  if (mobileBtn && drawer && closeBtn) {
    mobileBtn.addEventListener('click', () => {
      drawer.classList.add('open');
    });
    closeBtn.addEventListener('click', () => {
      drawer.classList.remove('open');
    });
  }
</script>