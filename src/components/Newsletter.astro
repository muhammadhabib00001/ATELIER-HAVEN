<section class="newsletter-section" id="newsletter" aria-labelledby="newsletter-heading">
  <div class="newsletter-inner">
    <div class="newsletter-text">
      <span class="newsletter-eyebrow">Free Newsletter</span>
      <h2 id="newsletter-heading" class="newsletter-title">Get Expert Home Advice Delivered Weekly</h2>
      <p class="newsletter-desc">Join 65,000+ homeowners, designers, and architects who receive our curated guides on architecture, interiors, and renovation every week.</p>
    </div>
    <form class="newsletter-form" onsubmit="event.preventDefault(); alert('Thank you for subscribing to Atrium Livings.');">
      <div class="newsletter-input-row">
        <input
          type="email"
          placeholder="Your email address"
          required
          aria-label="Email address for newsletter"
          class="newsletter-input"
        />
        <button type="submit" class="newsletter-btn">Subscribe</button>
      </div>
      <p class="newsletter-privacy">
        No spam. Unsubscribe anytime. By subscribing you agree to our <a href="/privacy-policy/">Privacy Policy</a>.
      </p>
    </form>
  </div>
</section>

<style>
  .newsletter-section {
    background-color: var(--color-accent);
    padding: 3.5rem 2rem;
    margin: 3.5rem 0;
  }

  .newsletter-inner {
    max-width: 800px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  .newsletter-eyebrow {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: 0.5rem;
  }

  .newsletter-title {
    font-family: var(--font-serif);
    font-size: 1.65rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.3;
    margin-bottom: 0.75rem;
  }

  .newsletter-desc {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.6;
  }

  .newsletter-form {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .newsletter-input-row {
    display: flex;
    gap: 0;
  }

  .newsletter-input {
    flex: 1;
    padding: 0.85rem 1rem;
    font-size: 0.9375rem;
    border: none;
    outline: none;
    background: #ffffff;
    color: var(--color-text-main);
    border-radius: 0;
  }

  .newsletter-input::placeholder {
    color: #999;
  }

  .newsletter-btn {
    padding: 0.85rem 1.5rem;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    background-color: #1a1a1a;
    color: #ffffff;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 0.15s ease;
  }

  .newsletter-btn:hover {
    background-color: #000000;
  }

  .newsletter-privacy {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.7);
  }

  .newsletter-privacy a {
    color: rgba(255, 255, 255, 0.9);
    text-decoration: underline;
  }

  @media (max-width: 680px) {
    .newsletter-inner {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .newsletter-section {
      padding: 2.5rem 1.25rem;
    }
    .newsletter-input-row {
      flex-direction: column;
    }
    .newsletter-btn {
      padding: 0.85rem;
    }
  }
</style>