---
---

<section class="newsletter-section" id="newsletter" aria-labelledby="newsletter-title">
  <div class="newsletter-inner">
    <span class="newsletter-kicker">The Atelier Haven Dispatch</span>
    <h2 id="newsletter-title" class="newsletter-title">Architectural Dispatches, Direct to Your Inbox</h2>
    <p class="newsletter-desc">
      Join over 65,000 architects, interior designers, and discerning homeowners receiving our weekly critique of global projects, material discoveries, and private home tours.
    </p>

    <form class="newsletter-form" onsubmit="event.preventDefault(); alert('Thank you for subscribing to Atelier Haven.');">
      <div class="input-group">
        <input 
          type="email" 
          placeholder="Enter your professional email address" 
          required 
          aria-label="Email Address for Newsletter"
          class="newsletter-input" 
        />
        <button type="submit" class="newsletter-btn">Subscribe Free</button>
      </div>
      <p class="newsletter-privacy-note">
        No spam, ever. Unsubscribe with a single click. Read our <a href="/privacy-policy">Privacy Policy</a>.
      </p>
    </form>
  </div>
</section>

<style>
  .newsletter-section {
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 4rem 2rem;
    margin: 4.5rem 0;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .newsletter-section::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 60px;
    height: 3px;
    background-color: var(--color-accent);
  }

  .newsletter-inner {
    max-width: 620px;
    margin: 0 auto;
  }

  .newsletter-kicker {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.75rem;
  }

  .newsletter-title {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-text-main);
    line-height: 1.25;
    margin-bottom: 1rem;
  }

  .newsletter-desc {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .newsletter-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .input-group {
    display: flex;
    gap: 0.5rem;
  }

  .newsletter-input {
    flex: 1;
    padding: 0.9rem 1.25rem;
    font-size: 0.9375rem;
    border: 1px solid var(--color-border-dark);
    border-radius: 4px;
    background-color: #FFFFFF;
    color: var(--color-text-main);
    outline: none;
    transition: border-color 0.2s ease;
  }

  .newsletter-input:focus {
    border-color: var(--color-dark);
  }

  .newsletter-btn {
    padding: 0.9rem 1.8rem;
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background-color: var(--color-dark);
    color: #FAF9F5;
    border: 1px solid var(--color-dark);
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .newsletter-btn:hover {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .newsletter-privacy-note {
    font-size: 0.75rem;
    color: var(--color-text-light);
  }

  .newsletter-privacy-note a {
    text-decoration: underline;
    color: var(--color-text-muted);
  }

  @media (max-width: 600px) {
    .input-group {
      flex-direction: column;
    }
    .newsletter-section {
      padding: 2.5rem 1.25rem;
    }
    .newsletter-title {
      font-size: 1.5rem;
    }
  }
</style>